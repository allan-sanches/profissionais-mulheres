---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FilterGroup from "@/components/blocks/FilterGroup.astro";
import SiteNav from "@/components/layout/SiteNav.astro";
import Footer from "@/components/layout/Footer.astro";
import ResearchersToolbar from "@/components/sections/ResearchersToolbar.astro";
import ResearchersTable from "@/components/sections/ResearchersTable.astro";
import ResearchersCards from "@/components/sections/ResearchersCards.astro";
import ResearchersPagination from "@/components/sections/ResearchersPagination.astro";
import site from "@/config/site";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import {
  NIVEL_LABELS,
  NIVEL_ORDER,
  IDENTIDADE_LABELS,
  IDENTIDADE_ORDER,
  RACA_LABELS,
  RACA_ORDER,
  ACEITA_ORDER,
  CATEGORY_BADGE,
  splitList,
  isGrupoTradicionalVazio,
  buildDedupIndex,
  formatPlace,
  parseRegion,
  compareRegions,
} from "@/utils/labels";
import { buildResearcherView } from "@/utils/researcher-view";
import type { CardData } from "@/utils/card-template";
import { identidade, pesquisadoras, textoPuro } from "@/config/aparencia";
import TextoRico from "@/components/blocks/TextoRico.astro";

// A pagina inteira roda no cliente: busca, filtros e paginacao percorrem a
// lista toda sem ida ao servidor. Por isso todas as pesquisadoras precisam
// estar no HTML — renderizar so a primeira pagina deixava as outras 239
// inalcancaveis, e ainda calculava as contagens dos filtros e a data de
// sincronizacao em cima de uma amostra de 20.
const researchers = await getCollection("researchers");

// Cada pesquisadora carrega o carimbo do sync que a gravou. O mais recente é
// a data em que a planilha oficial foi lida pela última vez — como o site é
// estático, essa data também é a do conteúdo que está no ar.
const ultimaSincronizacao = researchers.reduce<Date | undefined>((maior, r) => {
  const d = r.data.data_sincronizacao;
  return d && (!maior || d > maior) ? d : maior;
}, undefined);

const ultimaSincronizacaoLabel = ultimaSincronizacao
  ? new Intl.DateTimeFormat("pt-BR", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
      timeZone: "America/Sao_Paulo",
    }).format(ultimaSincronizacao)
  : null;

// Texto livre da planilha vem com pontuação/espaçamento inconsistentes
// ("Abaetetuba Pará Brasil" vs "Abaetetuba, Pará, Brasil"). buildDedupIndex
// agrupa essas variações; os resolvers são repassados pra cada linha da
// tabela pra que o valor exibido/filtrado seja sempre o mesmo representante.
const grupoTradicionalIndex = buildDedupIndex(
  researchers.map((r) =>
    isGrupoTradicionalVazio(r.data.grupo_tradicional)
      ? undefined
      : r.data.grupo_tradicional,
  ),
);
const localizacaoIndex = buildDedupIndex(
  researchers.map((r) => r.data.localizacao),
);
const trabalhoAtualIndex = buildDedupIndex(
  researchers.flatMap((r) => splitList(r.data.trabalho_atual)),
);
const instituicaoAtualIndex = buildDedupIndex(
  researchers.map((r) => r.data.instituicao_atual),
);
const areasPesquisaIndex = buildDedupIndex(
  researchers.flatMap((r) => r.data.areas_pesquisa || []),
);
const gruposBiologicosIndex = buildDedupIndex(
  researchers.flatMap((r) => r.data.grupos_biologicos || []),
);

const resolveLocalizacaoFormatted = (raw?: string) =>
  formatPlace(localizacaoIndex.resolve(raw));
const resolveInstituicaoAtualFormatted = (raw?: string) =>
  formatPlace(instituicaoAtualIndex.resolve(raw));

const resolvers = {
  resolveLocalizacao: resolveLocalizacaoFormatted,
  resolveInstituicaoAtual: resolveInstituicaoAtualFormatted,
  resolveGrupoTradicional: grupoTradicionalIndex.resolve,
  resolveTrabalhoAtual: trabalhoAtualIndex.resolve,
  resolveAreaPesquisa: areasPesquisaIndex.resolve,
  resolveGrupoBiologico: gruposBiologicosIndex.resolve,
};

// As contagens de cada opção de filtro saem dos MESMOS data-* que a
// filtragem no cliente compara. Derivar as duas coisas do view-model
// garante que o número exibido bate com o resultado do filtro.
const views = researchers.map((r) => buildResearcherView(r, resolvers));

// ── Dados dos cards, montados no cliente ──────────────────────────────────
// O card cabe mais etiqueta que a célula da tabela antes de precisar do +N.
const VISIBLE_BADGES = 5;

// A citação é cortada por número de caracteres, e não só por linhas: o
// line-clamp esconde via CSS mas mantém o texto inteiro no HTML, o que faria
// a busca da página e leitores de tela lerem um trecho que ninguém vê. Corta
// na última palavra inteira pra não terminar no meio de uma sílaba.
const BIO_MAX = 150;
function encurtarBio(texto: string, max: number) {
  if (texto.length <= max) return texto;
  const corte = texto.slice(0, max);
  const espaco = corte.lastIndexOf(" ");
  const base = espaco > max * 0.6 ? corte.slice(0, espaco) : corte;
  return base.replace(/[\s.,;:!?-]+$/, "") + "…";
}

// Só os campos que o card desenha — nada de markup. Sai como JSON no HTML
// (ver <script is:inline define:vars> no fim do arquivo) e é consumido por
// utils/card-template.ts.
const cardsData: CardData[] = views.map((vm) => ({
  slug: vm.dataAttrs["data-slug"],
  nome: vm.nomeFormatado,
  iniciais: vm.initials,
  nivel: vm.r.nivel_formacao ? NIVEL_LABELS[vm.r.nivel_formacao] : "",
  instituicao: vm.instituicaoFormatada,
  localizacao: vm.localizacaoFormatada,
  bio: vm.show("bio", vm.r.bio) ? encurtarBio(vm.r.bio!.trim(), BIO_MAX) : "",
  bioCompleta: vm.show("bio", vm.r.bio) ? vm.r.bio! : "",
  badges: vm.badges.slice(0, VISIBLE_BADGES).map((badge) => ({
    label: badge.label,
    // So viaja quando difere do exibido — nao vale inflar o JSON repetindo
    // o mesmo texto em 259 registros.
    ...(badge.full !== badge.label ? { full: badge.full } : {}),
    color: CATEGORY_BADGE[badge.key].color,
  })),
  extras: Math.max(0, vm.badges.length - VISIBLE_BADGES),
  links: vm.links.slice(0, 3).map((link) => ({
    href: link.href!,
    icon: link.icon,
    title: link.title,
  })),
  verPerfil: pesquisadoras.botoes.verPerfil,
}));

const countAttr = (attr: string, mode: "single" | "list" = "single") => {
  const counts = new Map<string, number>();
  for (const view of views) {
    const raw = view.dataAttrs[attr] || "";
    const values =
      mode === "list" ? raw.split("|").filter(Boolean) : raw ? [raw] : [];
    // Set: uma pesquisadora conta no máximo 1x por valor.
    for (const value of new Set(values)) {
      counts.set(value, (counts.get(value) || 0) + 1);
    }
  }
  return counts;
};

// Opções ordenadas por uma ordem fixa (enums), descartando o que não ocorre.
const optionsFromOrder = (
  order: string[],
  counts: Map<string, number>,
  labels: Record<string, string>,
  exclude: string[] = [],
) =>
  order
    .filter((v) => !exclude.includes(v) && (counts.get(v) ?? 0) > 0)
    .map((v) => ({ value: v, label: labels[v] ?? v, count: counts.get(v)! }));

// Opções de texto livre: alfabético, já deduplicado pelo índice.
const optionsFromCounts = (counts: Map<string, number>) =>
  [...counts.entries()]
    .map(([value, count]) => ({ value, label: value, count }))
    .sort((a, b) => a.label.localeCompare(b.label, "pt-BR"));

const identidadeOptions = optionsFromOrder(
  IDENTIDADE_ORDER,
  countAttr("data-identidade"),
  IDENTIDADE_LABELS,
  ["nao-informado"],
);
const racaOptions = optionsFromOrder(
  RACA_ORDER,
  countAttr("data-raca"),
  RACA_LABELS,
  ["nao-informado"],
);
const nivelFormacaoOptions = optionsFromOrder(
  NIVEL_ORDER,
  countAttr("data-nivel-formacao"),
  NIVEL_LABELS,
);
const aceitaPalestrasOptions = optionsFromOrder(
  ACEITA_ORDER,
  countAttr("data-aceita-palestras"),
  {},
);

const simNaoCounts = (attr: string) => {
  const counts = countAttr(attr);
  return [
    { value: "sim", label: "Sim", count: counts.get("sim") ?? 0 },
    { value: "nao", label: "Não", count: counts.get("nao") ?? 0 },
  ].filter((o) => o.count > 0);
};
const lgbtqiapOptions = simNaoCounts("data-lgbtqiap");
const pcdOptions = simNaoCounts("data-pcd");

const grupoTradicionalOptions = optionsFromCounts(
  countAttr("data-grupo-tradicional"),
);
const trabalhoAtualOptions = optionsFromCounts(
  countAttr("data-trabalho-atual", "list"),
);
const instituicaoAtualOptions = optionsFromCounts(
  countAttr("data-instituicao-atual"),
);
const areasPesquisaOptions = optionsFromCounts(
  countAttr("data-areas-pesquisa", "list"),
);
const gruposBiologicosOptions = optionsFromCounts(
  countAttr("data-grupos-biologicos", "list"),
);

// Região: UF quando é Brasil, país quando é fora. O rótulo legível vem do
// parseRegion; o value é o que fica no data-regiao das linhas.
const regiaoCounts = countAttr("data-regiao");
const regiaoOptions = [...regiaoCounts.entries()]
  .map(([value, count]) => ({
    value,
    label: parseRegion(value)?.label ?? value,
    count,
  }))
  .sort((a, b) => compareRegions(a, b));

const title = pesquisadoras.titulo;
// A <meta description> nao aceita marcacao, entao aqui vai a versao achatada do
// mesmo texto que o <p> desenha com as cores da marca.
const description = textoPuro(pesquisadoras.subtitulo);
---

<BaseLayout title={title} description={description}>
  <a href="#layout-root" class="sr-only focus:not-sr-only"
    >Pular para conteúdo principal</a
  >
  <div class="w-full">
    <SiteNav />

    <div class="mx-auto w-full max-w-[1800px] space-y-6 px-4 pb-6 md:px-8">
      {/* Header */}
      <div
        class="relative overflow-hidden rounded-lg bg-meco-purple-primary p-8 sm:p-12 md:p-16"
        style={`background-image: url('${pesquisadoras.imagemDeFundo}'); background-size: cover; background-position: center;`}
      >
        <div
          class="absolute inset-0 rounded-lg"
          style="background: linear-gradient(to bottom, rgba(125, 28, 212, 0.45), rgba(125, 28, 212, 0.60))"
        >
        </div>
        {
          /* Escala mobile-first: os tamanhos base valem na tela estreita e
          crescem a partir do sm. No mobile o titulo em text-5xl ocupava quase
          a altura toda da dobra e o paragrafo em text-xl empurrava a listagem
          pra fora da primeira tela. */
        }
        <div class="relative space-y-6 text-center sm:space-y-10">
          <h1
            class="font-epilogue text-3xl leading-tight font-black tracking-tight text-white sm:text-5xl md:text-6xl lg:text-7xl"
          >
            {title}
          </h1>
          {
            /* Rich text: o painel permite destacar trechos com as duas cores da
            marca. Sem destaque, sai um paragrafo branco como antes. */
          }
          <TextoRico
            conteudo={pesquisadoras.subtitulo}
            class="text-sm leading-relaxed font-semibold text-white sm:text-lg md:text-xl"
          />
        </div>
      </div>

      <div id="layout-root" tabindex="-1">
        {/* Main content */}
        <div class="min-w-0 space-y-6">
          <ResearchersToolbar
            ultimaSincronizacaoLabel={ultimaSincronizacaoLabel}
          />

          {/* div original - a remover */}

          {
            /* Chips dos filtros aplicados. Preenchidos pelo script a partir dos
          checkboxes marcados; cada um remove só o seu filtro. */
          }
          <div
            id="active-filter-chips"
            class="hidden flex-wrap items-center gap-2"
            aria-live="polite"
            aria-atomic="true"
          >
          </div>
          <button
            id="clear-filters-btn"
            type="button"
            class="hidden text-sm font-medium text-meco-purple-primary transition-colors hover:text-meco-purple-deep hover:underline"
          >
            {pesquisadoras.botoes.limparFiltros}
          </button>

          <ResearchersTable researchers={researchers} resolvers={resolvers} />

          {
            /* Container vazio: os cards da pagina corrente sao montados no
            cliente a partir de window.__CARDS_DATA__ (injetado no fim). */
          }
          <ResearchersCards />

          <ResearchersPagination />

          {/* Empty State */}
          <div
            id="empty-state"
            class="hidden flex-col items-center gap-3 rounded-lg border border-gray-200/90 bg-white py-16 text-center"
          >
            <Icon
              name="mdi:account-search-outline"
              class="size-16 text-gray-300"
            />
            <p class="text-lg font-semibold text-gray-700">
              {pesquisadoras.semResultados.titulo}
            </p>
            <p class="text-sm text-gray-500">
              {pesquisadoras.semResultados.descricao}
            </p>
          </div>
        </div>
      </div>

      {
        /* <dialog> nativo: o navegador ja cuida de prender o foco, fechar no
      Esc e escurecer o fundo — nada disso precisa de JS. */
      }
      <dialog
        id="help-dialog"
        class="m-auto w-[min(46rem,calc(100vw-1.5rem))] rounded-lg p-0 text-gray-700 backdrop:bg-gray-900/50"
        aria-labelledby="help-title"
      >
        <div
          class="flex items-center justify-between gap-3 bg-meco-purple-primary px-4 py-3 sm:px-6 sm:py-4"
        >
          <h2
            id="help-title"
            class="font-epilogue text-base font-bold text-white sm:text-lg"
          >
            Como utilizar esta tela
          </h2>
          <button
            id="help-close"
            type="button"
            class="flex size-8 shrink-0 items-center justify-center rounded-lg text-white transition-colors hover:bg-white/20"
            aria-label="Fechar"
          >
            <Icon name="mdi:close" class="size-5" />
          </button>
        </div>

        {
          /* Mais altura util no mobile: a modal e a unica coisa na tela, e com
          70vh o conteudo rolava dentro de uma caixa que ja tinha folga em volta.
          O texto tambem comeca menor — sao sete blocos de explicacao. */
        }
        <div
          class="max-h-[80vh] space-y-4 overflow-y-auto px-4 py-4 text-xs leading-relaxed sm:max-h-[70vh] sm:space-y-5 sm:px-6 sm:py-5 sm:text-sm"
        >
          {
            [
              {
                icone: "mdi:magnify",
                titulo: "Buscar",
                texto:
                  "O campo de busca filtra por nome da pesquisadora e por instituição, conforme você digita.",
              },
              {
                icone: "mdi:filter-variant",
                titulo: "Filtros",
                texto:
                  "O botão Filtros abre um painel lateral com formação, identidade, raça/etnia, área de pesquisa e outros recortes. Os filtros se combinam entre si, e os que estiverem ativos aparecem como etiquetas acima da lista, com um X para remover. Atalho: Ctrl+B (ou ⌘+B) abre e fecha o painel; Esc também fecha.",
              },
              {
                icone: "mdi:view-list",
                titulo: "Tabela ou Cards",
                texto:
                  "Alterne entre a tabela e a visão em cards pelos botões à direita. A escolha fica salva no seu navegador e vale nas próximas visitas.",
              },
              {
                icone: "mdi:arrow-split-vertical",
                titulo: "Largura das colunas",
                texto:
                  "Na tabela, arraste a alça entre os títulos das colunas para redimensionar. Ao arrastar, a tabela passa a rolar horizontalmente em vez de espremer as colunas vizinhas. Um duplo clique em qualquer alça devolve todas ao padrão, e recarregar a página também.",
              },
              {
                icone: "mdi:tag-multiple-outline",
                titulo: "Etiquetas de perfil",
                texto:
                  "A coluna Perfil & Atuação mostra as primeiras etiquetas de cada pesquisadora. Quando houver mais, aparece um +N — passe o mouse sobre ele para ver o restante.",
              },
              {
                icone: "mdi:page-next-outline",
                titulo: "Paginação",
                texto:
                  "Escolha quantas pesquisadoras aparecem por página nos seletores do topo ou do rodapé da lista — os dois são o mesmo controle. Os contadores mostram o intervalo exibido e o total de resultados.",
              },
              {
                icone: "mdi:account-details-outline",
                titulo: "Abrir um perfil",
                texto:
                  "Clique em qualquer linha da tabela ou em um card para ver o perfil completo, com todos os dados que a pesquisadora escolheu divulgar.",
              },
            ].map((item) => (
              <div class="flex gap-3">
                <Icon
                  name={item.icone}
                  class="mt-0.5 size-5 shrink-0 text-meco-purple-primary"
                />
                <div>
                  <h3 class="font-semibold text-gray-900">{item.titulo}</h3>
                  <p class="mt-1 text-gray-600">{item.texto}</p>
                </div>
              </div>
            ))
          }
        </div>
      </dialog>
    </div>

    <Footer />
  </div>

  {/* ── Drawer de filtros (off-canvas) ───────────────────────────── */}
  {
    /* Sem a classe `flex` aqui: ela viria de folha de autor e venceria o
    `dialog:not([open]) { display: none }` do navegador, deixando o drawer
    pintado mesmo fechado. O display mora em global.css, condicionado ao
    [open] — precisa ser uma folha compartilhada por todas as paginas pra
    sobreviver a troca de <head> do ClientRouter. */
  }
  <dialog
    id="filter-drawer"
    class="fixed inset-y-0 left-0 m-0 h-screen max-h-screen w-[30rem] max-w-[90vw] flex-col rounded-none p-0 backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm"
    aria-labelledby="filter-drawer-title"
  >
    <div class="flex flex-col bg-white">
      {/* Header */}
      <div
        class="flex shrink-0 items-center justify-between bg-meco-purple-primary px-6 py-5 text-white"
      >
        <div class="flex items-center gap-2.5">
          {
            /* Chip branco por baixo: o "m" da marca e roxo e sumiria no roxo do
            header. O fundo claro preserva as cores originais em vez de recolorir
            a logo, que descaracterizaria a marca. Substitui o icone de ajustes —
            o titulo ao lado ja diz que o painel e de filtros. */
          }
          <span
            class="flex shrink-0 items-center rounded-md bg-white px-1.5 py-1"
          >
            <img
              src={identidade.logoPainelDeFiltros}
              alt=""
              class="h-4 w-auto"
              decoding="async"
            />
          </span>
          <h2 id="filter-drawer-title" class="font-epilogue text-lg font-bold">
            Filtrar Pesquisadoras
          </h2>
          <span
            id="filter-active-count"
            class="badge-numero hidden bg-white text-[10px] font-bold text-meco-purple-primary"
            >0</span
          >
        </div>
        <button
          id="filter-drawer-close"
          type="button"
          class="rounded-lg p-1 text-white/70 transition-colors hover:bg-white/20 hover:text-white"
          aria-label="Fechar filtros"
        >
          <Icon name="mdi:close" class="size-5" />
        </button>
      </div>

      {/* Body */}
      <div class="flex-1 overflow-y-auto px-6 py-4">
        <div class="mb-1 flex justify-end">
          <button
            id="filter-clear-all"
            type="button"
            class="text-xs text-gray-500 transition-colors hover:text-red-600"
          >
            Limpar todos os filtros
          </button>
        </div>

        <FilterGroup
          title="Identidade de gênero"
          name="identidade"
          options={identidadeOptions}
          open
        />
        <FilterGroup title="Raça/cor" name="raca" options={racaOptions} />
        <FilterGroup
          title="Nível de formação"
          name="nivel-formacao"
          options={nivelFormacaoOptions}
        />
        <FilterGroup
          title="Grupo biológico"
          name="grupos-biologicos"
          options={gruposBiologicosOptions}
        />
        <FilterGroup
          title="Localização (UF / país)"
          name="regiao"
          options={regiaoOptions}
        />
        <FilterGroup
          title="Instituição atual"
          name="instituicao-atual"
          options={instituicaoAtualOptions}
        />
        <FilterGroup
          title="Área de pesquisa"
          name="areas-pesquisa"
          options={areasPesquisaOptions}
        />
        <FilterGroup
          title="LGBTQIAP+"
          name="lgbtqiap"
          options={lgbtqiapOptions}
        />
        <FilterGroup title="PCD" name="pcd" options={pcdOptions} />
        <FilterGroup
          title="Grupo tradicional"
          name="grupo-tradicional"
          options={grupoTradicionalOptions}
        />
        <FilterGroup
          title="Trabalho atual"
          name="trabalho-atual"
          options={trabalhoAtualOptions}
        />
        <FilterGroup
          title="Aceita palestra"
          name="aceita-palestras"
          options={aceitaPalestrasOptions}
        />
      </div>

      {/* Footer */}
      <div
        class="flex shrink-0 items-center gap-3 border-t border-gray-200 bg-gray-50 p-6"
      >
        <button
          id="filter-apply"
          type="button"
          class="w-full rounded-lg bg-meco-purple-primary px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-meco-purple-deep"
        >
          {pesquisadoras.botoes.aplicarFiltros}
        </button>
        <button
          id="filter-clear"
          type="button"
          class="shrink-0 rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-100"
        >
          {pesquisadoras.botoes.limparFiltros}
        </button>
      </div>
    </div>
  </dialog>

  {
    /* Dados dos cards. Vao como JSON puro, sem markup: e o que permite a visao
    de cards nascer vazia. `is:inline` porque define:vars serializa os valores
    direto no HTML — o <script> abaixo e um modulo bundlado e nao receberia. */
  }
  {
    /* `textoSemResultados` viaja junto porque o <script> abaixo e um modulo
    bundlado e nao enxerga o frontmatter. Sem isso o JS reescreveria com um
    texto fixo aquilo que o painel acabou de definir. */
  }
  <script
    is:inline
    define:vars={{
      cardsData,
      textoSemResultados: pesquisadoras.semResultados.titulo,
    }}
  >
    window.__CARDS_DATA__ = cardsData;
    window.__SEM_RESULTADOS__ = textoSemResultados;
  </script>

  <script>
    import {
      renderCard,
      readIconViewBoxes,
      type CardData,
    } from "@/utils/card-template";

    /*
     * Todo o comportamento da tela vive dentro de initDiretorio(), chamada a
     * cada `astro:page-load`.
     *
     * Este <script> vira um modulo ES com src proprio, e um modulo so executa
     * UMA VEZ por URL: o ClientRouter reinsere a tag ao voltar do perfil, mas
     * o navegador nao reexecuta o modulo. O DOM da volta e novo e os listeners
     * ficaram no DOM descartado — a tela inteira (drawer, filtros, busca,
     * paginacao, troca de visao) ficava inerte na volta.
     *
     * `astro:page-load` dispara na primeira carga E depois de cada navegacao,
     * entao religa tudo no DOM corrente. Listeners de elemento morrem junto
     * com o DOM antigo; os de window/document ficariam acumulando, por isso o
     * unico que existe (Ctrl+B) e registrado fora daqui, uma vez so.
     */
    function initDiretorio() {
      // Drawer de filtros off-canvas: desliza da esquerda sobre a página, com
      // backdrop desfocado. Fica sempre fora do fluxo, então abrir/fechar nunca
      // reflui a tabela — a listagem ocupa a largura toda o tempo inteiro.
      const drawer = document.getElementById(
        "filter-drawer",
      ) as HTMLDialogElement | null;
      const drawerCloseBtn = document.getElementById("filter-drawer-close");
      const toggleBtn = document.getElementById("toggle-filters-btn");

      // Rede de segurança: se o navegador restaurar a página do bfcache com o
      // dialog aberto, a volta do perfil cairia numa tela travada.
      if (drawer?.open) drawer.close();

      toggleBtn?.addEventListener("click", () => {
        if (drawer?.open) {
          drawer.close();
        } else {
          drawer?.showModal();
        }
      });

      drawerCloseBtn?.addEventListener("click", () => drawer?.close());

      // Clique no backdrop fecha o dialog (nativo)
      drawer?.addEventListener("click", (e) => {
        if (e.target === drawer) drawer.close();
      });

      // Acordeão: só uma categoria de filtro fica aberta por vez, pra não
      // precisar de scroll interno em cada uma.
      const accordionItems = document.querySelectorAll<HTMLDetailsElement>(
        ".filter-accordion-item",
      );
      accordionItems.forEach((item) => {
        item.addEventListener("toggle", () => {
          if (!item.open) return;
          accordionItems.forEach((other) => {
            if (other !== item) other.open = false;
          });
        });
      });

      // Busca dentro de uma categoria (Localização, Instituição atual): filtra
      // só as opções visíveis daquele grupo, sem mexer nos resultados da tabela.
      document
        .querySelectorAll<HTMLInputElement>("input[data-option-search]")
        .forEach((input) => {
          const name = input.dataset.optionSearch;
          const list = document.querySelector<HTMLElement>(
            `[data-option-list="${name}"]`,
          );
          if (!list) return;
          input.addEventListener("input", () => {
            const query = input.value.trim().toLowerCase();
            list
              .querySelectorAll<HTMLElement>("[data-option-label]")
              .forEach((label) => {
                const text = label.dataset.optionLabel || "";
                label.style.display =
                  !query || text.includes(query) ? "" : "none";
              });
          });
        });

      // Client-side filtering. Cada grupo de filtro (checkboxes) faz OR entre
      // si e AND com os demais grupos e a busca por nome.
      const FILTER_GROUPS: { name: string; mode: "single" | "list" }[] = [
        { name: "identidade", mode: "single" },
        { name: "raca", mode: "single" },
        { name: "lgbtqiap", mode: "single" },
        { name: "pcd", mode: "single" },
        { name: "grupo-tradicional", mode: "single" },
        { name: "regiao", mode: "single" },
        { name: "nivel-formacao", mode: "single" },
        { name: "trabalho-atual", mode: "list" },
        { name: "instituicao-atual", mode: "single" },
        { name: "areas-pesquisa", mode: "list" },
        { name: "grupos-biologicos", mode: "list" },
        { name: "aceita-palestras", mode: "single" },
      ];

      const searchInput = document.getElementById(
        "filter-search",
      ) as HTMLInputElement | null;
      const applyBtn = document.getElementById("filter-apply");
      const clearBtn = document.getElementById("filter-clear");
      const tableContainer = document.getElementById("researchers-container");
      const cardsContainer = document.getElementById("cards-view-container");
      const emptyState = document.getElementById("empty-state");

      const getChecked = (name: string): string[] =>
        Array.from(
          document.querySelectorAll<HTMLInputElement>(
            `input[data-filter-group="${name}"]:checked`,
          ),
        ).map((el) => el.value);

      // A tabela é a única visão renderizada no servidor, e é sobre os data-*
      // dela que busca e filtros trabalham — continua sendo a fonte de verdade
      // da filtragem, independente da visão que estiver na tela.
      const rowBySlug = new Map<string, HTMLElement>();
      tableContainer
        ?.querySelectorAll<HTMLElement>("[data-slug]")
        .forEach((el) => {
          const slug = el.dataset.slug;
          if (slug) rowBySlug.set(slug, el);
        });

      // Os viewBox vem do banco de simbolos que esta neste documento, entao
      // precisam ser relidos aqui: o ClientRouter troca o documento a cada
      // navegacao e leva o banco junto.
      readIconViewBoxes();

      // Dados dos cards, injetados como JSON pelo servidor. Indexados por slug
      // pra montar o card na hora em que ele entra na página corrente.
      const cardDataBySlug = new Map<string, CardData>();
      for (const card of (window as any).__CARDS_DATA__ ?? []) {
        cardDataBySlug.set(card.slug, card);
      }

      // Visualização (tabela/cards) — persistida em localStorage.
      const LS_VIEW = "meco_view_mode";
      const tableWrapper = document.getElementById("table-view-container");
      const cardsWrapper = document.getElementById("cards-view-container");
      const viewTableBtn = document.getElementById("btn-view-table");
      const viewCardsBtn = document.getElementById("btn-view-cards");

      let currentView: "table" | "cards" = "table";
      try {
        const storedView = localStorage.getItem(LS_VIEW);
        if (storedView === "table" || storedView === "cards")
          currentView = storedView;
      } catch {}

      /*
       * No mobile a listagem e sempre em cards: a tabela tem cinco colunas e
       * nao cabe numa tela estreita sem rolagem horizontal. O breakpoint e o
       * mesmo `sm` que esconde o alternador na toolbar.
       *
       * `currentView` guarda a PREFERENCIA da pessoa, que sobrevive intacta —
       * quem escolheu tabela no desktop volta a ve-la ao alargar a janela.
       * Quem decide o que aparece agora e `visaoEfetiva()`.
       */
      const telaLarga = window.matchMedia("(min-width: 640px)");
      const visaoEfetiva = (): "table" | "cards" =>
        telaLarga.matches ? currentView : "cards";

      function applyView() {
        const showTable = visaoEfetiva() === "table";

        tableWrapper?.classList.toggle("hidden", !showTable);
        // O container de cards é um grid: alterna hidden/grid pra não perder o
        // layout de colunas ao reexibir.
        cardsWrapper?.classList.toggle("hidden", showTable);
        cardsWrapper?.classList.toggle("grid", !showTable);

        for (const [btn, isActive] of [
          [viewTableBtn, showTable],
          [viewCardsBtn, !showTable],
        ] as const) {
          if (!btn) continue;
          const icon = btn.querySelector("svg");
          if (icon) {
            icon.classList.toggle("text-meco-purple-primary", isActive);
            icon.classList.toggle("text-gray-400", !isActive);
          }
          btn.setAttribute("aria-pressed", String(isActive));
        }
      }

      function setView(view: "table" | "cards") {
        currentView = view;
        try {
          localStorage.setItem(LS_VIEW, view);
        } catch {}
        applyView();
        // Alternar pra cards é o gatilho de montagem: até aqui o container está
        // vazio (primeira troca) ou com a página anterior (trocas seguintes).
        renderCardsDaPagina(slugsPaginaAtual);
      }

      viewTableBtn?.addEventListener("click", () => setView("table"));
      viewCardsBtn?.addEventListener("click", () => setView("cards"));
      applyView();

      // Girar o aparelho ou redimensionar a janela cruza o breakpoint: quem
      // prefere tabela e estreita a janela cai pra cards, e volta pra tabela ao
      // alargar. Sem isso a tela ficaria com a visao errada ate um novo clique.
      telaLarga.addEventListener("change", () => {
        applyView();
        renderCardsDaPagina(slugsPaginaAtual);
      });

      // Paginação — aplicada em cima do resultado já filtrado/buscado.
      const PAGE_SIZES = [5, 10, 20, 50, 100];
      const LS_PAGE_SIZE = "pesquisadoras:page-size";

      let pageSize = 20;
      try {
        const stored = Number(localStorage.getItem(LS_PAGE_SIZE));
        if (PAGE_SIZES.includes(stored)) pageSize = stored;
      } catch {}

      let currentPage = 1;
      let filteredSlugs: string[] = [];

      // Há dois seletores de itens por página (toolbar e barra de paginação):
      // mudar um espelha no outro pra não mostrarem valores diferentes.
      const pageSizeSelects = Array.from(
        document.querySelectorAll<HTMLSelectElement>("select[data-page-size]"),
      );
      const paginationBar = document.getElementById("pagination-bar");
      const paginationInfo = document.getElementById("pagination-info");
      const pageIndicator = document.getElementById("page-indicator");
      const firstBtn = document.getElementById(
        "page-first",
      ) as HTMLButtonElement | null;
      const prevBtn = document.getElementById(
        "page-prev",
      ) as HTMLButtonElement | null;
      const nextBtn = document.getElementById(
        "page-next",
      ) as HTMLButtonElement | null;
      const lastBtn = document.getElementById(
        "page-last",
      ) as HTMLButtonElement | null;

      const syncPageSizeSelects = () => {
        for (const select of pageSizeSelects) select.value = String(pageSize);
      };
      syncPageSizeSelects();

      // Slugs da página corrente, guardados pra que trocar pra visão de cards
      // possa montá-los sem refazer filtro e paginação.
      let slugsPaginaAtual: string[] = [];
      // Assinatura do último HTML montado: evita reconstruir o mesmo conteúdo
      // quando renderPage roda de novo sem mudança de página (ex.: troca de
      // visão de ida e volta).
      let assinaturaCards = "";

      /**
       * Monta no cliente só os cards da página corrente — no máximo `pageSize`
       * (100 no maior seletor), nunca as 259. Enquanto a tabela está na tela o
       * trabalho é adiado: a assinatura é zerada pra forçar a montagem quando a
       * pessoa alternar pra cards.
       */
      function renderCardsDaPagina(slugs: string[]) {
        slugsPaginaAtual = slugs;
        if (!cardsContainer) return;

        if (visaoEfetiva() !== "cards") {
          assinaturaCards = "";
          return;
        }

        const assinatura = slugs.join("|");
        if (assinatura === assinaturaCards) return;
        assinaturaCards = assinatura;

        cardsContainer.innerHTML = slugs
          .map((slug) => {
            const dados = cardDataBySlug.get(slug);
            return dados ? renderCard(dados) : "";
          })
          .join("");
      }

      function renderPage() {
        rowBySlug.forEach((row) => (row.style.display = "none"));

        const total = filteredSlugs.length;
        const totalPages = Math.max(1, Math.ceil(total / pageSize));
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        const start = (currentPage - 1) * pageSize;
        const end = start + pageSize;
        const slugsDaPagina = filteredSlugs.slice(start, end);

        slugsDaPagina.forEach((slug) => {
          const row = rowBySlug.get(slug);
          if (row) row.style.display = "";
        });

        renderCardsDaPagina(slugsDaPagina);

        // Os dois contadores saem dos mesmos start/end/total: enquanto o de
        // cima era calculado fora do renderPage, ele mostrava o total filtrado
        // e o de baixo a janela da página, divergindo a cada paginação.
        const SEM_RESULTADOS =
          (window as any).__SEM_RESULTADOS__ ??
          "Nenhuma pesquisadora encontrada";
        const inicio = start + 1;
        const fim = Math.min(end, total);

        if (paginationInfo) {
          paginationInfo.textContent =
            total === 0
              ? SEM_RESULTADOS
              : `Mostrando ${inicio}–${fim} de ${total} pesquisadoras`;
        }
        if (resultsCounter) {
          resultsCounter.innerHTML =
            total === 0
              ? SEM_RESULTADOS
              : `Exibindo <strong class="text-gray-900">${inicio}–${fim}</strong> de <strong class="text-gray-900">${total}</strong>`;
        }
        if (pageIndicator) {
          pageIndicator.textContent = `Página ${currentPage} de ${totalPages}`;
        }

        if (firstBtn) firstBtn.disabled = currentPage <= 1;
        if (prevBtn) prevBtn.disabled = currentPage <= 1;
        if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
        if (lastBtn) lastBtn.disabled = currentPage >= totalPages;

        paginationBar?.classList.toggle("hidden", total === 0);
        emptyState?.classList.toggle("hidden", total > 0);
        emptyState?.classList.toggle("flex", total === 0);
      }

      function goToPage(page: number) {
        currentPage = page;
        renderPage();
      }

      firstBtn?.addEventListener("click", () => goToPage(1));
      prevBtn?.addEventListener("click", () => goToPage(currentPage - 1));
      nextBtn?.addEventListener("click", () => goToPage(currentPage + 1));
      lastBtn?.addEventListener("click", () =>
        goToPage(Math.max(1, Math.ceil(filteredSlugs.length / pageSize))),
      );

      for (const select of pageSizeSelects) {
        select.addEventListener("change", () => {
          const value = Number(select.value);
          if (!PAGE_SIZES.includes(value)) return;
          pageSize = value;
          try {
            localStorage.setItem(LS_PAGE_SIZE, String(value));
          } catch {}
          syncPageSizeSelects();
          currentPage = 1;
          renderPage();
        });
      }

      const filterCountBadge = document.getElementById("filter-count-badge");
      const filterActiveCount = document.getElementById("filter-active-count");
      const clearAllBtn = document.getElementById("filter-clear-all");
      const resultsCounter = document.getElementById("results-counter");

      // Mantém os dois contadores de "filtros ativos" (o do botão da toolbar e o
      // do header do painel) em sincronia.
      function renderActiveCount(count: number) {
        for (const el of [filterCountBadge, filterActiveCount]) {
          if (!el) continue;
          el.textContent = String(count);
          // São círculos flex: alterna hidden/flex pra centralizar o número.
          el.classList.toggle("hidden", count === 0);
          el.classList.toggle("flex", count > 0);
        }
      }

      /*
       * Os checkboxes do drawer sao rascunho: marcar um nao mexe na listagem.
       * Só "Aplicar Filtros" promove o rascunho a estado aplicado, que é o que
       * a listagem, os chips e os contadores leem. Sem isso a lista se
       * remontava a cada clique, e quem queria combinar quatro recortes via a
       * tela piscar quatro vezes pelo caminho.
       */
      let appliedFilters = new Map<string, string[]>();

      const lerRascunho = () =>
        new Map(FILTER_GROUPS.map((g) => [g.name, getChecked(g.name)]));

      const inputDoFiltro = (group: string, value: string) =>
        document.querySelector<HTMLInputElement>(
          `input[data-filter-group="${group}"][value="${CSS.escape(value)}"]`,
        );

      /** Promove o rascunho a aplicado e refaz a listagem. */
      function aplicarFiltros() {
        appliedFilters = lerRascunho();
        filterResearchers();
      }

      /**
       * Devolve os checkboxes ao que está de fato aplicado. Roda ao fechar o
       * drawer: quem marca opções e desiste (Esc, X, clique no backdrop) nao
       * pode reabrir o painel e ver marcado o que nunca entrou em vigor.
       * Depois de Aplicar é inócuo — rascunho e aplicado já são iguais.
       */
      function descartarRascunho() {
        for (const [group, values] of appliedFilters) {
          for (const el of document.querySelectorAll<HTMLInputElement>(
            `input[data-filter-group="${group}"]`,
          )) {
            el.checked = values.includes(el.value);
          }
        }
      }

      function filterResearchers() {
        const searchValue = (searchInput?.value || "").trim().toLowerCase();
        const active = FILTER_GROUPS.map((g) => ({
          ...g,
          checked: appliedFilters.get(g.name) ?? [],
        }));

        renderActiveCount(active.reduce((sum, f) => sum + f.checked.length, 0));
        renderChips();

        filteredSlugs = Array.from(rowBySlug.entries())
          .filter(([, row]) => {
            // data-busca já vem com nome + instituição em minúsculas.
            const haystack = row.getAttribute("data-busca") || "";
            const matchSearch = !searchValue || haystack.includes(searchValue);

            const matchFilters = active.every((f) => {
              if (f.checked.length === 0) return true;
              const raw = row.getAttribute(`data-${f.name}`) || "";
              if (f.mode === "list") {
                const values = raw.split("|").filter(Boolean);
                return f.checked.some((c) => values.includes(c));
              }
              return f.checked.includes(raw);
            });

            return matchSearch && matchFilters;
          })
          .map(([slug]) => slug);

        currentPage = 1;
        renderPage();
      }

      // A busca continua reagindo a cada tecla: ela mora na toolbar, fora do
      // drawer, e digitar já é a confirmação. Os checkboxes, não — eles são
      // rascunho até o Aplicar.
      searchInput?.addEventListener("input", filterResearchers);

      applyBtn?.addEventListener("click", () => {
        aplicarFiltros();
        drawer?.close();
      });

      // `close` cobre todas as saídas do drawer — X, Esc, clique no backdrop e
      // o próprio Aplicar. Depois de Aplicar não há o que descartar, então um
      // único gancho dá conta das duas situações.
      drawer?.addEventListener("close", descartarRascunho);

      /** Zera só o rascunho: desmarca tudo e reabre as opções que a busca
       * interna de cada categoria tinha escondido. Não mexe na listagem. */
      function limparRascunho() {
        document
          .querySelectorAll<HTMLInputElement>("input[data-filter-group]")
          .forEach((el) => (el.checked = false));
        // Limpa também as buscas internas das categorias e reexibe as opções
        // que estavam escondidas por elas.
        document
          .querySelectorAll<HTMLInputElement>("input[data-option-search]")
          .forEach((input) => {
            input.value = "";
            const list = document.querySelector<HTMLElement>(
              `[data-option-list="${input.dataset.optionSearch}"]`,
            );
            list
              ?.querySelectorAll<HTMLElement>("[data-option-label]")
              .forEach((label) => (label.style.display = ""));
          });
      }

      /** Limpa e já aplica — para os controles que ficam FORA do drawer e por
       * isso agem sobre o que está em vigor, não sobre o rascunho. */
      function limparTudoEAplicar() {
        limparRascunho();
        if (searchInput) searchInput.value = "";
        aplicarFiltros();
      }

      // Dentro do drawer, "Limpar" zera só as marcações: nada ali vale sem
      // Aplicar, e desistir é fechar o painel.
      clearBtn?.addEventListener("click", limparRascunho);
      // Na faixa de chips, o alvo é o filtro em vigor — some na hora.
      clearAllBtn?.addEventListener("click", limparTudoEAplicar);

      // ── Chips dos filtros aplicados ──────────────────────────────────
      // Espelham os checkboxes marcados: desmarcar pelo X do chip é a mesma
      // ação que desmarcar no drawer, então os dois nunca saem de sincronia.
      const chipsContainer = document.getElementById("active-filter-chips");

      function renderChips() {
        if (!chipsContainer) return;
        // Vem do aplicado, e nao dos checkboxes: com o drawer aberto e um
        // rascunho por confirmar, digitar na busca redesenharia os chips com
        // marcacoes que ainda nao entraram em vigor.
        const checked = Array.from(appliedFilters.entries()).flatMap(
          ([group, values]) =>
            values
              .map((value) => inputDoFiltro(group, value))
              .filter((el): el is HTMLInputElement => el !== null),
        );

        chipsContainer.replaceChildren();
        chipsContainer.classList.toggle("hidden", checked.length === 0);
        chipsContainer.classList.toggle("flex", checked.length > 0);
        if (checked.length === 0) return;

        for (const input of checked) {
          // O texto visível da opção mora no <span> irmão dentro do <label>.
          const label =
            input.parentElement?.querySelector("span")?.textContent?.trim() ??
            input.value;
          // Remove o "(N)" da contagem — no chip ele só polui.
          const text = label.replace(/\s*\(\d+\)\s*$/, "");

          const chip = document.createElement("span");
          chip.className =
            "inline-flex items-center gap-1 rounded-full border border-meco-purple-soft/50 bg-meco-purple-bg px-2.5 py-1 text-xs font-medium text-meco-purple-deep";

          const textNode = document.createElement("span");
          textNode.textContent = text;
          chip.appendChild(textNode);

          const remove = document.createElement("button");
          remove.type = "button";
          remove.className =
            "rounded-full p-0.5 text-meco-purple-deep/60 transition-colors hover:bg-meco-purple-soft/40 hover:text-meco-purple-deep";
          remove.setAttribute("aria-label", `Remover filtro ${text}`);
          remove.innerHTML =
            '<svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>';
          // O chip representa filtro em vigor, entao o X age na hora — sem
          // passar pelo Aplicar, que e so o compromisso do painel.
          remove.addEventListener("click", () => {
            input.checked = false;
            aplicarFiltros();
          });
          chip.appendChild(remove);

          chipsContainer.appendChild(chip);
        }

        const clearAll = document.createElement("button");
        clearAll.type = "button";
        clearAll.className =
          "text-xs font-semibold text-gray-500 underline-offset-2 transition-colors hover:text-red-600 hover:underline";
        clearAll.textContent = "Limpar todos os filtros";
        // Fica na faixa de chips, fora do drawer: age sobre o filtro em vigor,
        // entao limpa e aplica de uma vez.
        clearAll.addEventListener("click", limparTudoEAplicar);
        chipsContainer.appendChild(clearAll);
      }

      // ── Linha da tabela clicável ─────────────────────────────────────
      // A coluna "Ações" saiu; a linha inteira leva ao perfil. O link no nome
      // continua existindo pra teclado, nova aba e clique do meio.
      tableContainer?.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.closest("a")) return; // deixa o link nativo agir
        if (window.getSelection()?.toString()) return; // seleção de texto
        // Elementos marcados com data-no-nav (o <details> das etiquetas) têm
        // interação própria: sem isso, abrir a lista navegaria pro perfil.
        if (target.closest("[data-no-nav]")) return;
        const row = target.closest<HTMLElement>("tr[data-href]");
        const href = row?.dataset.href;
        if (href) window.location.href = href;
      });

      // ── Colunas redimensionáveis ─────────────────────────────────────
      // A tabela sempre carrega responsiva, sem rolagem horizontal: o arrasto
      // vale para a sessão e não é persistido. Guardar as larguras significaria
      // restaurar o estado congelado no load — que tem largura em pixels e por
      // isso rola. Limpa o que versões anteriores salvaram.
      try {
        localStorage.removeItem("meco_col_widths");
        localStorage.removeItem("meco_col_widths_v2");
      } catch {}
      const table = document.getElementById(
        "researchers-table",
      ) as HTMLTableElement | null;
      const cols = Array.from(
        table?.querySelectorAll<HTMLTableColElement>("colgroup col") ?? [],
      );

      const MIN_COL_WIDTH = 90;
      let resizeReady = false;

      // Larguras padrão (as porcentagens do HTML), lidas antes de qualquer
      // congelamento sobrescrever o style inline.
      const defaultWidths = cols.map((col) => col.style.width);

      const applyColWidth = (i: number, px: number) => {
        cols[i].style.width = `${px}px`;
      };

      const totalColWidth = () =>
        cols.reduce(
          (soma, col) => soma + (parseInt(col.style.width, 10) || 0),
          0,
        );

      // Em table-fixed com largura 100%, o navegador normaliza a soma das
      // colunas pra caber na tabela: alargar uma encolhe as outras na mesma
      // proporção. Pra uma coluna se mover sozinha, o total precisa deixar de
      // ser fixo — daí congelar todas em px e fixar a largura da tabela na soma
      // delas. A partir daí a tabela cresce e o container rola, em vez de
      // roubar espaço das vizinhas.
      const isFrozen = () => table!.style.width.endsWith("px");

      const freezeColWidths = () => {
        if (isFrozen()) return;
        Array.from(table!.querySelectorAll<HTMLElement>("thead th")).forEach(
          (th, i) => applyColWidth(i, th.offsetWidth),
        );
        table!.style.width = `${totalColWidth()}px`;
      };

      // Volta ao estado responsivo: porcentagens do HTML e tabela em 100%.
      const resetColWidths = () => {
        cols.forEach((col, i) => {
          col.style.width = defaultWidths[i];
        });
        table!.style.width = "";
      };

      // Só dá pra medir a largura das colunas com a tabela visível — se a visão
      // salva for "cards" ela começa oculta (offsetWidth 0), então adiamos a
      // inicialização até a tabela aparecer.
      function initColumnWidths() {
        if (resizeReady || !table || !cols.length) return;
        const headers = Array.from(
          table.querySelectorAll<HTMLElement>("thead th"),
        );
        if (headers.some((th) => th.offsetWidth === 0)) return; // ainda oculta

        resizeReady = true;
      }

      table?.querySelectorAll<HTMLElement>(".col-resizer").forEach((handle) => {
        const index = Number(handle.dataset.resizeCol);

        handle.addEventListener("pointerdown", (e) => {
          if (!resizeReady) return;
          e.preventDefault();
          e.stopPropagation();
          freezeColWidths();
          const startX = e.clientX;
          const startWidth = parseInt(cols[index].style.width, 10);
          handle.setPointerCapture(e.pointerId);
          document.body.style.userSelect = "none";
          document.body.style.cursor = "col-resize";

          const onMove = (ev: PointerEvent) => {
            applyColWidth(
              index,
              Math.max(MIN_COL_WIDTH, startWidth + (ev.clientX - startX)),
            );
            // A tabela acompanha o novo total, senão a normalização volta a
            // redistribuir a diferença entre as outras colunas.
            table!.style.width = `${totalColWidth()}px`;
          };
          const onUp = () => {
            handle.removeEventListener("pointermove", onMove);
            handle.removeEventListener("pointerup", onUp);
            document.body.style.userSelect = "";
            document.body.style.cursor = "";
          };
          handle.addEventListener("pointermove", onMove);
          handle.addEventListener("pointerup", onUp);
        });

        // Duplo clique redefine todas as colunas: devolver uma só ao padrão
        // misturaria px com porcentagem e traria o empurrão de volta.
        handle.addEventListener("dblclick", (e) => {
          if (!resizeReady) return;
          e.preventDefault();
          e.stopPropagation();
          resetColWidths();
        });
      });

      initColumnWidths();
      // Registrado depois do handler que troca a visão, então a tabela já está
      // visível quando este roda.
      viewTableBtn?.addEventListener("click", initColumnWidths);

      // ── Modal "Como utilizar" ────────────────────────────────────────
      const helpDialog = document.getElementById(
        "help-dialog",
      ) as HTMLDialogElement | null;
      document
        .getElementById("help-btn")
        ?.addEventListener("click", () => helpDialog?.showModal());
      document
        .getElementById("help-close")
        ?.addEventListener("click", () => helpDialog?.close());
      // Clique fora do conteúdo: o alvo do clique é o próprio <dialog> só quando
      // ele cai no backdrop, então isso não fecha ao clicar no texto.
      helpDialog?.addEventListener("click", (e) => {
        if (e.target === helpDialog) helpDialog.close();
      });

      // ── Table Sorting ────────────────────────────────────────────────
      const tableHeaders = table?.querySelectorAll<HTMLElement>("thead th");
      let currentSort = { col: -1, asc: true };

      tableHeaders?.forEach((th, index) => {
        if (index === tableHeaders.length - 1) return; // Pular última coluna
        th.style.cursor = "pointer";
        th.setAttribute("aria-sort", "none");
        th.addEventListener("click", () => {
          const rows = Array.from(
            table!.querySelectorAll<HTMLTableRowElement>("tbody tr"),
          );
          const isAsc = currentSort.col === index ? !currentSort.asc : true;

          rows.sort((a, b) => {
            const aVal = a.children[index].textContent?.toLowerCase() || "";
            const bVal = b.children[index].textContent?.toLowerCase() || "";
            return isAsc ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
          });

          rows.forEach((row) =>
            table!.querySelector("tbody")!.appendChild(row),
          );
          currentSort = { col: index, asc: isAsc };
          tableHeaders.forEach((h, i) => {
            h.setAttribute(
              "aria-sort",
              i === index ? (isAsc ? "ascending" : "descending") : "none",
            );
          });
        });
      });

      // ── Botão "Limpar filtros" ──────────────────────────────────────
      const clearFiltersBtn = document.getElementById("clear-filters-btn");
      const updateClearBtnVisibility = () => {
        const hasFilters =
          (
            document.getElementById("filter-search") as HTMLInputElement
          )?.value.trim() !== "";
        if (hasFilters) {
          clearFiltersBtn?.classList.remove("hidden");
        } else {
          clearFiltersBtn?.classList.add("hidden");
        }
      };
      clearFiltersBtn?.addEventListener("click", () => {
        // Fica na toolbar, fora do drawer: age sobre o que esta em vigor.
        limparTudoEAplicar();
        updateClearBtnVisibility();
        updateURL();
      });
      document
        .getElementById("filter-search")
        ?.addEventListener("input", updateClearBtnVisibility);
      updateClearBtnVisibility();

      // ── URL Query Parameters ────────────────────────────────────────
      const updateURL = () => {
        const params = new URLSearchParams();
        const searchVal = (
          document.getElementById("filter-search") as HTMLInputElement
        )?.value;
        const pageVal = currentPage;
        if (searchVal) params.set("q", searchVal);
        if (pageVal > 1) params.set("page", String(pageVal));
        const newURL = params.toString()
          ? `?${params.toString()}`
          : location.pathname;
        window.history.replaceState({}, "", newURL);
      };

      // Restaurar state da URL
      const urlParams = new URLSearchParams(location.search);
      const initialSearch = urlParams.get("q");
      const initialPage = parseInt(urlParams.get("page") || "1");
      if (initialSearch) {
        (document.getElementById("filter-search") as HTMLInputElement).value =
          initialSearch;
        currentPage = initialPage;
      }

      // Atualizar URL quando filtros mudam
      document
        .getElementById("filter-search")
        ?.addEventListener("input", () => {
          currentPage = 1;
          filterResearchers();
          updateURL();
        });

      // Estado inicial: sem filtros aplicados ainda mostra a 1ª página de todas.
      filterResearchers();
      updateURL();
    }

    // Dispara na primeira carga e depois de cada navegacao do ClientRouter.
    document.addEventListener("astro:page-load", initDiretorio);

    /*
     * Atalho global, registrado uma unica vez na vida do modulo: window
     * sobrevive a troca de pagina, entao registrar dentro de initDiretorio()
     * empilharia um listener novo a cada navegacao. Busca o dialog na hora do
     * evento pra nunca guardar referencia a um DOM ja descartado.
     */
    document.addEventListener("keydown", (e) => {
      if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== "b") return;
      const tag = (e.target as HTMLElement | null)?.tagName ?? "";
      if (tag === "INPUT" || tag === "TEXTAREA") return;
      const dlg = document.getElementById(
        "filter-drawer",
      ) as HTMLDialogElement | null;
      if (!dlg) return;
      e.preventDefault();
      if (dlg.open) dlg.close();
      else dlg.showModal();
    });
  </script>
</BaseLayout>
