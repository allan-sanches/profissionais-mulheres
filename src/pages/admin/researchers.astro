---
import BaseLayout from "@/layouts/BaseLayout.astro";
import fs from "fs/promises";
import path from "path";

interface SyncLog {
  timestamp: string;
  status: "SUCCESS" | "FAILED";
  message: string;
  count: number;
}

let syncHistory: SyncLog[] = [];
try {
  const logPath = new URL(
    "../../../src/content/researchers.sync.log",
    import.meta.url,
  );
  const logContent = await fetch(logPath)
    .then((r) => (r.ok ? r.text() : ""))
    .catch(() => "");
  if (logContent) {
    syncHistory = logContent
      .split("---")
      .filter((e) => e.trim())
      .map((entry) => {
        const lines = entry.trim().split("\n");
        return {
          timestamp: lines[0]?.replace(/[\[\]]/g, "") || "",
          status: (lines[1] || "").includes("SUCCESS")
            ? ("SUCCESS" as const)
            : ("FAILED" as const),
          message: lines[2]?.replace("Message: ", "") || "",
          count: parseInt(lines[3]?.replace("Count: ", "") || "0"),
        };
      })
      .reverse();
  }
} catch (e) {}

let documentacao = "";
try {
  const docPath = path.resolve("./src/content/documentacao.json");
  const raw = await fs.readFile(docPath, "utf-8");
  documentacao = JSON.parse(raw).conteudo || "";
} catch (e) {}
---

<BaseLayout title="Admin - Pesquisadoras">
  <div class="mx-auto max-w-4xl space-y-12 px-4 py-10">
    <header class="border-b pb-8 dark:border-neutral-800">
      <h1 class="font-serif text-3xl text-primary italic">
        Painel de Controle
      </h1>
      <p class="mt-2 font-light text-neutral-500">
        Atualize o catálogo via Google Sheets.
      </p>
    </header>

    <div
      id="auth-container"
      class="rounded-xl border bg-neutral-50 p-8 dark:bg-neutral-900/50"
    >
      <h2 class="mb-4 font-serif text-lg font-medium">Acesso Restrito</h2>
      <div class="flex max-w-md gap-3">
        <input
          type="password"
          id="admin-token"
          placeholder="Senha de admin..."
          class="flex-1 rounded-lg border p-2.5 dark:bg-neutral-800"
        />
        <button
          id="btn-authenticate"
          class="rounded-lg bg-neutral-900 px-6 py-2.5 font-bold text-white dark:bg-white dark:text-neutral-900"
          >ENTRAR</button
        >
      </div>
    </div>

    <div id="admin-panel" class="hidden space-y-10">
      <section
        class="relative overflow-hidden rounded-2xl bg-neutral-900 p-8 text-white shadow-xl dark:bg-neutral-100 dark:text-neutral-900"
      >
        <h2 class="mb-6 font-serif text-2xl italic">Sincronizar Dados</h2>
        <button
          id="btn-sync"
          class="flex items-center gap-3 rounded-full bg-primary px-8 py-4 font-bold text-white shadow-lg transition-transform hover:scale-105"
        >
          <span id="btn-text">🚀 ATUALIZAR LISTA AGORA</span>
          <div
            id="btn-spinner"
            class="hidden h-5 w-5 animate-spin rounded-full border-2 border-white/20 border-t-white"
          >
          </div>
        </button>
      </section>

      <div class="grid gap-6 text-center sm:grid-cols-2">
        <div class="rounded-xl border bg-white p-6 dark:bg-neutral-950">
          <span
            class="text-xs font-bold tracking-widest text-neutral-400 uppercase"
            >Total Sincronizado</span
          >
          <p class="mt-2 text-4xl font-light" id="res-count">
            {syncHistory[0]?.count || "0"}
          </p>
        </div>
        <div class="rounded-xl border bg-white p-6 dark:bg-neutral-950">
          <span
            class="text-xs font-bold tracking-widest text-neutral-400 uppercase"
            >Último Refresh</span
          >
          <p class="mt-2 text-lg font-medium" id="res-date">
            {syncHistory[0]?.timestamp || "---"}
          </p>
        </div>
      </div>

      <section class="rounded-xl border bg-white p-8 dark:bg-neutral-950">
        <div class="mb-4 flex items-center justify-between gap-4">
          <h2 class="font-serif text-2xl italic">Documentação</h2>
          <a
            href="/keystatic/singleton/documentacao"
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 rounded-lg border px-4 py-2 text-sm font-bold text-neutral-700 transition-colors hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-800"
          >
            ✏️ Editar no Keystatic
          </a>
        </div>
        <p class="mb-4 text-sm text-neutral-500">
          Explicação de como usar o Keystatic e os botões do painel. Esta seção
          é atualizada aos poucos direto pelo link acima.
        </p>
        <div
          class="rounded-lg bg-neutral-50 p-6 text-sm leading-relaxed whitespace-pre-wrap text-neutral-700 dark:bg-neutral-900 dark:text-neutral-300"
        >
          {documentacao || "Nenhuma documentação cadastrada ainda."}
        </div>
      </section>
    </div>
  </div>

  <script>
    const authBox = document.getElementById("auth-container");
    const panelBox = document.getElementById("admin-panel");
    const input = document.getElementById("admin-token") as HTMLInputElement;
    const btnSync = document.getElementById("btn-sync");

    let token = sessionStorage.getItem("admin_token") || "";
    if (token) attemptLogin(token);

    document
      .getElementById("btn-authenticate")
      ?.addEventListener("click", () => attemptLogin(input.value.trim()));

    async function attemptLogin(t: string) {
      const res = await fetch("/api/admin/verify-token", {
        method: "POST",
        headers: {
          Authorization: `Bearer ${t}`,
          "Content-Type": "application/json",
        },
      });
      if (res.ok) {
        token = t;
        sessionStorage.setItem("admin_token", t);
        authBox?.classList.add("hidden");
        panelBox?.classList.remove("hidden");
      } else {
        alert("Chave inválida.");
      }
    }

    btnSync?.addEventListener("click", async () => {
      if (!confirm("Isso atualizará os dados do site. Confirmar?")) return;

      const btnText = document.getElementById("btn-text");
      const spinner = document.getElementById("btn-spinner");

      btnSync.setAttribute("disabled", "true");
      btnText!.textContent = "SINCRONIZANDO...";
      spinner?.classList.remove("hidden");

      try {
        const res = await fetch("/api/sync-researchers", {
          method: "POST",
          headers: { Authorization: `Bearer ${token}` },
        });

        if (res.ok) {
          const data = await res.json();
          alert(`Sucesso! ${data.count} pesquisadoras sincronizadas.`);
          window.location.reload();
        } else {
          alert("Erro na sincronização.");
        }
      } catch (e) {
        alert("Erro de rede.");
      } finally {
        btnSync.removeAttribute("disabled");
        btnText!.textContent = "🚀 ATUALIZAR LISTA AGORA";
        spinner?.classList.add("hidden");
      }
    });
  </script>
</BaseLayout>
