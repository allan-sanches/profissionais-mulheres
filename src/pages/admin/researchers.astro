---
import BaseLayout from "@/layouts/BaseLayout.astro";

type SyncStatus = "SUCCESS" | "FAILED";

interface SyncLog {
  timestamp: string;
  status: SyncStatus;
  message: string;
  count: number;
}

let syncHistory: SyncLog[] = [];
try {
  const logPath = new URL(
    "../../content/researchers.sync.log",
    import.meta.url,
  );
  const logContent = await fetch(logPath)
    .then((r) => (r.ok ? r.text() : ""))
    .catch(() => "");

  if (logContent) {
    const entries = logContent.split("---").filter((e) => e.trim());
    syncHistory = entries
      .map((entry) => {
        const lines = entry.trim().split("\n");
        return {
          timestamp: lines[0]?.replace(/[\[\]]/g, "") || "",
          status: (lines[1] || "").includes("SUCCESS")
            ? ("SUCCESS" as const)
            : ("FAILED" as const),
          message: lines[2]?.replace("Message: ", "") || "",
          count: parseInt(lines[3]?.replace("Count: ", "") || "0"),
        };
      })
      .reverse();
  }
} catch (e) {
  console.log("Sem log de sincronização");
}

const title = "Administração do Catálogo";
const description =
  "Atualize a lista de pesquisadoras a partir da planilha oficial";
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-4xl space-y-12 px-4 py-10">
    <header
      class="space-y-4 border-b border-neutral-200 pb-8 dark:border-neutral-800"
    >
      <h1
        class="text-3xl font-light tracking-tight text-neutral-900 sm:text-4xl dark:text-neutral-100"
      >
        Painel de <span class="font-serif text-primary italic">Controle</span>
      </h1>
      <p class="font-light text-neutral-500 dark:text-neutral-400">
        Bem-vinda. Aqui você pode sincronizar os novos dados do Google Sheets
        com o site.
      </p>
    </header>

    <div
      id="auth-container"
      class="rounded-xl border border-neutral-200 bg-neutral-50/50 p-8 backdrop-blur-sm dark:border-neutral-800 dark:bg-neutral-900/50"
    >
      <div class="max-w-md space-y-4">
        <h2 class="text-lg font-medium">Acesso Restrito</h2>
        <p class="text-sm text-neutral-600 dark:text-neutral-400">
          Insira sua chave de acesso para liberar as atualizações:
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <input
            type="password"
            id="admin-token"
            placeholder="Sua chave de acesso..."
            class="flex-1 rounded-lg border border-neutral-300 bg-white px-4 py-2.5 outline-none focus:ring-2 focus:ring-primary/20 dark:border-neutral-700 dark:bg-neutral-800"
          />
          <button
            id="btn-authenticate"
            class="rounded-lg bg-neutral-900 px-6 py-2.5 font-medium text-white hover:bg-neutral-800 dark:bg-neutral-100 dark:text-neutral-900"
          >
            Entrar
          </button>
        </div>
      </div>
    </div>

    <div id="admin-panel" class="hidden space-y-10">
      <section
        class="relative overflow-hidden rounded-2xl bg-neutral-900 p-8 text-white shadow-xl dark:bg-neutral-100 dark:text-neutral-900"
      >
        <div class="relative z-10 space-y-6">
          <div>
            <h2 class="text-2xl font-light">Sincronizar Planilha</h2>
            <p class="mt-1 font-light text-neutral-400 dark:text-neutral-600">
              Busca novos cadastros e atualiza o catálogo no site.
            </p>
          </div>

          <button
            id="btn-sync"
            class="group relative flex items-center gap-3 rounded-full bg-primary px-8 py-4 font-bold text-white shadow-lg shadow-primary/30 transition-all hover:scale-105 active:scale-95"
          >
            <span id="btn-text">🚀 ATUALIZAR LISTA AGORA</span>
            <div
              id="btn-spinner"
              class="hidden h-5 w-5 animate-spin rounded-full border-2 border-white/30 border-t-white"
            >
            </div>
          </button>

          <div
            id="sync-status-msg"
            class="hidden animate-pulse text-sm font-medium text-primary-foreground/80"
          >
            Processando... por favor, não feche esta página.
          </div>
        </div>
      </section>

      <div class="grid gap-6 sm:grid-cols-2">
        <div
          class="rounded-xl border border-neutral-200 p-6 dark:border-neutral-800"
        >
          <span
            class="text-xs font-bold tracking-widest text-neutral-500 uppercase"
            >Total no Catálogo</span
          >
          <p class="mt-2 text-4xl font-light" id="researchers-count">--</p>
        </div>
        <div
          class="rounded-xl border border-neutral-200 p-6 dark:border-neutral-800"
        >
          <span
            class="text-xs font-bold tracking-widest text-neutral-500 uppercase"
            >Último Refresh</span
          >
          <p
            class="mt-2 text-lg font-medium text-neutral-700 dark:text-neutral-300"
            id="last-sync"
          >
            --
          </p>
        </div>
      </div>

      <section class="space-y-4">
        <h2
          class="font-serif text-xl font-light text-neutral-800 italic dark:text-neutral-200"
        >
          Histórico de Atividade
        </h2>
        <div
          class="divide-y divide-neutral-100 overflow-hidden rounded-xl border border-neutral-200 bg-white dark:divide-neutral-800 dark:border-neutral-800 dark:bg-neutral-950"
        >
          {
            syncHistory.length === 0 ? (
              <p class="p-8 text-center text-sm text-neutral-500 italic">
                Nenhum registro encontrado.
              </p>
            ) : (
              syncHistory.slice(0, 5).map((log) => (
                <div class="flex items-center justify-between p-4 transition-colors hover:bg-neutral-50 dark:hover:bg-neutral-900/50">
                  <div class="flex items-center gap-4">
                    <div
                      class={`h-2 w-2 rounded-full ${log.status === "SUCCESS" ? "bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.5)]" : "bg-red-500"}`}
                    />
                    <div>
                      <p class="text-sm font-medium text-neutral-800 dark:text-neutral-200">
                        {log.message}
                      </p>
                      <p class="text-xs text-neutral-500">{log.timestamp}</p>
                    </div>
                  </div>
                  {log.status === "SUCCESS" && (
                    <span class="rounded bg-primary/10 px-2 py-1 text-xs font-bold text-primary">
                      +{log.count}
                    </span>
                  )}
                </div>
              ))
            )
          }
        </div>
      </section>
    </div>
  </div>

  <script>
    const authContainer = document.getElementById("auth-container");
    const adminPanel = document.getElementById("admin-panel");
    const tokenInput = document.getElementById(
      "admin-token",
    ) as HTMLInputElement;
    const btnAuthenticate = document.getElementById("btn-authenticate");
    const btnSync = document.getElementById("btn-sync");
    const btnText = document.getElementById("btn-text");
    const btnSpinner = document.getElementById("btn-spinner");
    const statusMsg = document.getElementById("sync-status-msg");
    const countDisplay = document.getElementById("researchers-count");
    const lastSyncDisplay = document.getElementById("last-sync");

    let currentToken = sessionStorage.getItem("admin_token") || "";

    // Se já tiver token, tenta validar automaticamente
    if (currentToken) {
      validateAndShow(currentToken);
    }

    btnAuthenticate?.addEventListener("click", () => {
      const token = tokenInput.value.trim();
      if (token) validateAndShow(token);
    });

    async function validateAndShow(token: string) {
      try {
        const response = await fetch("/api/admin/verify-token", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token}`, // <--- CORREÇÃO: Enviando no Header como a API espera
          },
        });

        if (response.ok) {
          currentToken = token;
          sessionStorage.setItem("admin_token", token);
          authContainer?.classList.add("hidden");
          adminPanel?.classList.remove("hidden");
          await refreshData();
        } else {
          sessionStorage.removeItem("admin_token");
          alert("Chave de acesso inválida.");
        }
      } catch (e) {
        alert("Erro ao conectar com o servidor.");
      }
    }

    btnSync?.addEventListener("click", async () => {
      if (
        !btnSync ||
        !confirm(
          "Deseja atualizar os dados agora? Isso substituirá as informações atuais.",
        )
      )
        return;

      btnSync.setAttribute("disabled", "true");
      btnText!.textContent = "SINCRONIZANDO...";
      btnSpinner?.classList.remove("hidden");
      statusMsg?.classList.remove("hidden");

      try {
        const response = await fetch("/api/sync-researchers", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${currentToken}`,
          },
        });

        if (response.ok) {
          const data = await response.json();
          alert(`Sucesso! ${data.count} pesquisadoras sincronizadas.`);
          window.location.reload();
        } else {
          alert("Erro na sincronização. Verifique as permissões da planilha.");
        }
      } catch (error) {
        alert("Erro de rede.");
      } finally {
        btnSync.removeAttribute("disabled");
        btnText!.textContent = "🚀 ATUALIZAR LISTA AGORA";
        btnSpinner?.classList.add("hidden");
        statusMsg?.classList.add("hidden");
      }
    });

    async function refreshData() {
      try {
        const response = await fetch("/api/admin/status", {
          headers: { Authorization: `Bearer ${currentToken}` },
        });
        if (response.ok) {
          const data = await response.json();
          if (countDisplay) countDisplay.textContent = data.count.toString();
          if (lastSyncDisplay)
            lastSyncDisplay.textContent = data.lastSync || "Nunca";
        }
      } catch (e) {}
    }

    tokenInput?.addEventListener("keypress", (e) => {
      if (e.key === "Enter") btnAuthenticate?.click();
    });
  </script>
</BaseLayout>
