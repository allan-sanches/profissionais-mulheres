---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/layout/SiteNav.astro";
import Footer from "@/components/layout/Footer.astro";

/*
 * Cadastro na rede pelo próprio site. A página é estática; as perguntas vêm do
 * Google Forms em tempo de visita (src/components/cadastro/cadastro.ts), então
 * uma edição no formulário aparece aqui sem novo deploy.
 */

const botao =
  "rounded-lg px-5 py-2.5 text-sm font-bold transition-colors disabled:cursor-wait disabled:opacity-60";
---

<BaseLayout
  title="Cadastro"
  description="Cadastre-se na rede de pesquisadoras Mulheres na Ecologia."
>
  <div class="w-full">
    <SiteNav />

    <main class="mx-auto w-full max-w-3xl px-4 py-6 md:px-8 md:py-10">
      <div id="cadastro" aria-busy="true">
        <div
          data-estado="carregando"
          class="rounded-lg border border-gray-200/90 bg-white p-6 text-gray-600 sm:p-8"
        >
          <p class="animate-pulse">Carregando o formulário…</p>
        </div>

        <div
          data-estado="indisponivel"
          hidden
          class="rounded-lg border border-gray-200/90 bg-white p-6 sm:p-8"
        >
          <h1 class="font-epilogue text-2xl font-bold text-meco-purple-deep">
            Cadastro indisponível no momento
          </h1>
          <p class="mt-3 text-gray-700">
            Não conseguimos carregar o formulário. Tente de novo em alguns
            minutos.
          </p>
        </div>

        <div
          data-estado="fechado"
          hidden
          class="rounded-lg border border-gray-200/90 bg-white p-6 sm:p-8"
        >
          <h1 class="font-epilogue text-2xl font-bold text-meco-purple-deep">
            Cadastro encerrado
          </h1>
          <p
            class="mt-3 whitespace-pre-line text-gray-700"
            data-mensagem-fechado
          >
            O formulário não está aceitando respostas no momento.
          </p>
        </div>

        <form data-estado="formulario" hidden novalidate class="space-y-6">
          <header
            data-cabecalho
            class="rounded-lg border-t-8 border-meco-purple-primary bg-white p-6 shadow-sm sm:p-8"
          >
          </header>

          <div
            data-rascunho
            hidden
            class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-meco-purple-soft/50 bg-meco-purple-bg/40 p-4 text-sm text-gray-800"
          >
            <p>Recuperamos o que você já tinha preenchido nesta aba.</p>
            <button
              type="button"
              data-descartar
              class="font-semibold text-meco-purple-primary underline hover:text-meco-purple-deep"
            >
              Começar de novo
            </button>
          </div>

          <div
            data-secoes
            class="rounded-lg border border-gray-200/90 bg-white p-4 sm:p-7"
          >
          </div>

          {
            /* Campo-isca: fora da tela e fora da ordem de tabulação. Gente não
            vê, robô preenche — e o servidor descarta o envio. */
          }
          <div
            class="absolute -left-[9999px] h-px w-px overflow-hidden"
            aria-hidden="true"
          >
            <label>
              Não preencha este campo
              <input
                type="text"
                name="site_web"
                tabindex="-1"
                autocomplete="off"
              />
            </label>
          </div>

          <div data-turnstile></div>

          <div data-aviso role="alert" hidden></div>

          <div class="flex items-center justify-between gap-3">
            <button
              type="button"
              data-voltar
              hidden
              class:list={[
                botao,
                "border border-gray-200 bg-white text-gray-700 hover:text-meco-purple-deep",
              ]}
            >
              Voltar
            </button>
            <p data-progresso class="text-sm text-gray-500"></p>
            <button
              type="button"
              data-avancar
              class:list={[
                botao,
                "ml-auto bg-meco-purple-primary text-white hover:bg-meco-purple-deep",
              ]}
            >
              Próxima
            </button>
          </div>
        </form>

        <div
          data-estado="enviado"
          hidden
          class="rounded-lg border-t-8 border-meco-green-primary bg-white p-6 shadow-sm sm:p-8"
        >
          <h2
            tabindex="-1"
            class="font-epilogue text-2xl font-bold text-meco-green-dark focus:outline-none"
          >
            Cadastro enviado
          </h2>
          <p class="mt-3 whitespace-pre-line text-gray-700" data-confirmacao>
            Sua resposta foi registrada.
          </p>
          <a
            href="/"
            class="mt-6 inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-600 transition-colors hover:text-meco-purple-deep"
          >
            Ver a rede de pesquisadoras
          </a>
        </div>
      </div>

      <noscript>
        <p
          class="rounded-lg border border-gray-200/90 bg-white p-6 text-gray-700"
        >
          O cadastro precisa de JavaScript ativado no navegador.
        </p>
      </noscript>
    </main>

    <Footer />
  </div>
</BaseLayout>

<script>
  import { iniciarCadastro } from "@/components/cadastro/cadastro";

  // A cada navegação, inclusive a primeira (ver o comentário em index.astro).
  document.addEventListener("astro:page-load", iniciarCadastro);
</script>
