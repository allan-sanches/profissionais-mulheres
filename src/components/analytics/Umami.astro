---
// src/components/analytics/Umami.astro
import { UMAMI_URL, UMAMI_WEBSITE_ID } from "astro:env/client";

// Só renderiza o script se as variáveis existirem
const isEnabled = !!(UMAMI_URL && UMAMI_WEBSITE_ID);
---

{
  isEnabled && (
    <script
      is:inline
      async
      defer
      data-website-id={UMAMI_WEBSITE_ID}
      src={`${UMAMI_URL}/script.js`}
    />
  )
}
