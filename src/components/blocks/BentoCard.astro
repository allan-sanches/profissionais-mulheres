---
import { Icon } from "astro-icon/components";

interface Props {
  title?: string;
  icon?: string;
  class?: string;
}

const { title, icon, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "relative flex flex-col overflow-hidden rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-lg",
    className,
  ]}
>
  {
    title && (
      <div class="mb-3 flex items-center gap-1.5 text-xs font-semibold tracking-wide text-base-content/50 uppercase">
        {icon && <Icon name={icon} class="size-3.5" />}
        {title}
      </div>
    )
  }
  <div class="flex flex-1 flex-col">
    <slot />
  </div>
</div>
