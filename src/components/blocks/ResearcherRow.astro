---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { NIVEL_LABELS, CATEGORY_BADGE, PILL_BASE } from "@/utils/labels";
import {
  buildResearcherView,
  type ResearcherResolvers,
} from "@/utils/researcher-view";

interface Props extends ResearcherResolvers {
  researcher: CollectionEntry<"researchers">;
}

const { researcher, ...resolvers } = Astro.props;
const vm = buildResearcherView(researcher, resolvers);
const { r } = vm;

// Mínimo de 4 pílulas inline; a coluna estreita as distribui em linhas. O
// excedente vai pro popover flutuante, que não altera a altura da linha.
const VISIBLE_BADGES = 4;
const visibleBadges = vm.badges.slice(0, VISIBLE_BADGES);
const remainingBadges = vm.badges.slice(VISIBLE_BADGES);
---

<tr
  class="group cursor-pointer border-b border-gray-100 transition-colors last:border-b-0 hover:bg-meco-purple-bg/20"
  data-href={`/pesquisadoras/${researcher.id}`}
  {...vm.dataAttrs}
>
  {/* Pesquisadora */}
  <td class="px-6 py-4">
    <a
      href={`/pesquisadoras/${researcher.id}`}
      class="group/link flex items-center gap-3"
    >
      <div
        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-meco-purple-primary/15 to-meco-green-primary/15 font-epilogue text-sm font-bold text-meco-purple-primary"
      >
        {vm.initials}
      </div>
      <div class="min-w-0">
        <h4
          class="truncate font-epilogue text-base font-bold text-meco-purple-primary transition-colors group-hover/link:text-meco-purple-deep"
        >
          {vm.primeiroNome}
        </h4>
        {
          vm.restoNome && (
            <p class="truncate text-sm text-gray-500">{vm.restoNome}</p>
          )
        }
      </div>
    </a>
  </td>

  {/* Instituição */}
  <td class="px-4 py-4 text-sm font-medium text-gray-800">
    <div class="truncate" title={vm.instituicaoFormatada}>
      {vm.instituicaoFormatada || "—"}
    </div>
  </td>

  {/* Formação */}
  <td class="px-4 py-4">
    {
      r.nivel_formacao && (
        <span class="inline-block rounded-md bg-gray-100 px-2.5 py-1 text-sm font-semibold text-gray-700">
          {NIVEL_LABELS[r.nivel_formacao]}
        </span>
      )
    }
    {
      vm.show("formacao", r.formacao) && (
        <p class="mt-0.5 truncate text-sm text-gray-500" title={r.formacao}>
          {r.formacao}
        </p>
      )
    }
  </td>

  {/* Localização */}
  <td class="px-4 py-4 text-base text-gray-600">
    {
      vm.localizacaoFormatada ? (
        <div class="truncate" title={vm.localizacaoFormatada}>
          <Icon
            name="mdi:map-marker-outline"
            class="mr-1.5 inline size-3.5 text-gray-500"
          />
          {vm.localizacaoFormatada}
        </div>
      ) : (
        "—"
      )
    }
  </td>

  {/* Perfil & Atuação */}
  <td class="px-4 py-4">
    <div class="flex flex-wrap items-center gap-1.5">
      {
        visibleBadges.map((badge) => (
          <span
            class={`${PILL_BASE} ${CATEGORY_BADGE[badge.key].color} max-w-full whitespace-normal`}
          >
            {badge.label}
          </span>
        ))
      }

      {
        /* <details> em vez de abrir no hover: hover nao existe em toque nem em
        teclado, e as etiquetas que sobram aqui costumam ser justamente
        LGBTQIAP+, PCD e grupo tradicional. O summary ja e focavel, alterna com
        Enter/Espaco e anuncia expandido/recolhido sem nenhum JavaScript.
        data-no-nav impede que o clique suba pra linha e navegue pro perfil. */
      }
      {
        remainingBadges.length > 0 && (
          <details class="relative inline-block" data-no-nav>
            <summary
              class="badge-numero flex cursor-pointer list-none bg-[#bf9ee3] text-xs font-bold text-gray-950 transition-colors hover:bg-[#a67fbc] focus-visible:ring-2 focus-visible:ring-meco-purple-primary focus-visible:outline-none [&::-webkit-details-marker]:hidden"
              aria-label={`Mostrar mais ${remainingBadges.length} etiqueta${remainingBadges.length > 1 ? "s" : ""} de ${vm.primeiroNome}`}
            >
              +{remainingBadges.length}
            </summary>
            <div class="absolute bottom-full left-1/2 z-50 mb-2 flex w-max max-w-xs -translate-x-1/2 flex-wrap gap-1.5 rounded-lg border border-gray-200 bg-white p-2.5 shadow-md">
              {remainingBadges.map((badge) => (
                <span class="rounded-full bg-meco-purple-bg px-2 py-0.5 text-xs font-semibold text-meco-purple-deep">
                  {badge.label}
                </span>
              ))}
            </div>
          </details>
        )
      }

      {vm.badges.length === 0 && <span class="text-gray-500">—</span>}
    </div>
  </td>
</tr>
