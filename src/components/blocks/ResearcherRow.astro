---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { NIVEL_LABELS, CATEGORY_BADGE, PILL_BASE } from "@/utils/labels";
import {
  buildResearcherView,
  type ResearcherResolvers,
} from "@/utils/researcher-view";

interface Props extends ResearcherResolvers {
  researcher: CollectionEntry<"researchers">;
}

const { researcher, ...resolvers } = Astro.props;
const vm = buildResearcherView(researcher, resolvers);
const { r } = vm;

// Até 3 pílulas inline; o excedente vai pro popover flutuante, que não
// altera a altura da linha.
const VISIBLE_BADGES = 3;
const visibleBadges = vm.badges.slice(0, VISIBLE_BADGES);
const remainingBadges = vm.badges.slice(VISIBLE_BADGES);
---

<tr
  class="group border-b border-gray-100 transition-colors last:border-b-0 hover:bg-meco-purple-bg/20"
  {...vm.dataAttrs}
>
  {/* Pesquisadora */}
  <td class="px-6 py-4">
    <a
      href={`/pesquisadoras/${researcher.id}`}
      class="group/link flex items-center gap-3"
    >
      <div
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-meco-purple-primary/15 to-meco-green-primary/15 font-epilogue text-xs font-bold text-meco-purple-primary"
      >
        {vm.initials}
      </div>
      <div class="min-w-0">
        <h4
          class="truncate font-epilogue font-bold text-gray-900 transition-colors group-hover/link:text-meco-purple-primary"
        >
          {vm.primeiroNome}
        </h4>
        {
          vm.restoNome && (
            <p class="truncate text-xs text-gray-500">{vm.restoNome}</p>
          )
        }
      </div>
    </a>
  </td>

  {/* Instituição */}
  <td class="max-w-56 truncate px-4 py-4 text-sm font-medium text-gray-800">
    {vm.instituicaoFormatada || "—"}
  </td>

  {/* Formação */}
  <td class="max-w-48 px-4 py-4">
    {
      r.nivel_formacao && (
        <span class="inline-block rounded-md bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-700">
          {NIVEL_LABELS[r.nivel_formacao]}
        </span>
      )
    }
    {
      vm.show("formacao", r.formacao) && (
        <p class="mt-0.5 max-w-[180px] truncate text-xs text-gray-400">
          {r.formacao}
        </p>
      )
    }
  </td>

  {/* Localização */}
  <td class="px-4 py-4 text-sm whitespace-nowrap text-gray-600">
    {
      vm.localizacaoFormatada ? (
        <>
          <Icon
            name="mdi:map-marker-outline"
            class="mr-1.5 inline size-3 text-gray-400"
          />
          {vm.localizacaoFormatada}
        </>
      ) : (
        "—"
      )
    }
  </td>

  {/* Perfil & Atuação */}
  <td class="px-4 py-4">
    <div class="flex flex-wrap items-center gap-1.5">
      {
        visibleBadges.map((badge) => (
          <span class={`${PILL_BASE} ${CATEGORY_BADGE[badge.key].color}`}>
            <Icon name={CATEGORY_BADGE[badge.key].icon} class="size-3" />
            {badge.label}
          </span>
        ))
      }

      {
        remainingBadges.length > 0 && (
          <div class="group/popover relative inline-block">
            <span class="cursor-pointer rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-bold text-gray-600 transition-colors hover:bg-gray-200">
              +{remainingBadges.length}
            </span>
            <div class="absolute bottom-full left-1/2 z-50 mb-2 hidden w-64 -translate-x-1/2 flex-wrap gap-1.5 rounded-xl border border-gray-100 bg-white p-2.5 shadow-xl group-hover/popover:flex">
              {remainingBadges.map((badge) => (
                <span class="rounded-full bg-meco-purple-bg px-2 py-0.5 text-[10px] font-semibold text-meco-purple-deep">
                  {badge.label}
                </span>
              ))}
            </div>
          </div>
        )
      }

      {vm.badges.length === 0 && <span class="text-gray-400">—</span>}
    </div>
  </td>

  {/* Ações / Perfil */}
  <td class="px-6 py-4 text-right whitespace-nowrap">
    <a
      href={`/pesquisadoras/${researcher.id}`}
      class="inline-flex items-center gap-1 rounded-lg border border-meco-purple-soft/50 bg-meco-purple-bg px-3 py-1.5 text-xs font-bold text-meco-purple-deep transition-all hover:bg-meco-purple-primary hover:text-white"
    >
      Ver perfil
      <Icon name="mdi:arrow-right" class="size-3" />
    </a>
  </td>
</tr>
