---
import { Icon } from "astro-icon/components";

interface Option {
  value: string;
  label: string;
}

interface Props {
  title: string;
  name: string;
  options: Option[];
  open?: boolean;
  searchable?: boolean;
}

const { title, name, options, open = false, searchable = false } = Astro.props;
---

<details
  class="filter-accordion-item border-b border-gray-100 py-3"
  open={open}
>
  <summary
    class="group flex cursor-pointer list-none items-center justify-between text-xs font-bold tracking-wider text-gray-500 uppercase [&::-webkit-details-marker]:hidden"
  >
    <span>
      {title}
      <span class="font-medium text-gray-400 normal-case">
        ({options.length})
      </span>
    </span>
    <Icon
      name="mdi:chevron-down"
      class="size-4 shrink-0 text-gray-400 transition-transform group-open:rotate-180"
    />
  </summary>

  {
    searchable && (
      <div class="relative mt-2">
        <Icon
          name="mdi:magnify"
          class="absolute top-1/2 left-2.5 size-3.5 -translate-y-1/2 text-gray-400"
        />
        <input
          type="search"
          class="w-full rounded-lg border border-gray-300 bg-gray-50 py-1.5 pr-2 pl-8 text-xs focus:border-transparent focus:bg-white focus:ring-2 focus:ring-meco-purple-primary focus:outline-none"
          data-option-search={name}
          placeholder={`Buscar ${title.toLowerCase()}...`}
        />
      </div>
    )
  }

  <div
    class:list={[
      "mt-2 flex flex-col gap-0.5 pr-1",
      searchable && "max-h-48 overflow-y-auto",
    ]}
    data-option-list={name}
  >
    {
      options.length === 0 && (
        <p class="py-1 text-xs text-gray-400">Nenhuma opção</p>
      )
    }
    {
      options.map((opt) => (
        <label
          class="flex cursor-pointer items-start gap-2 rounded px-1 py-1 text-sm text-gray-700 hover:bg-gray-50"
          data-option-label={opt.label.toLowerCase()}
        >
          <input
            type="checkbox"
            class="mt-0.5 shrink-0 rounded border-gray-300 text-meco-purple-primary focus:ring-meco-purple-primary"
            data-filter-group={name}
            value={opt.value}
          />
          <span class="leading-tight">{opt.label}</span>
        </label>
      ))
    }
  </div>
</details>
