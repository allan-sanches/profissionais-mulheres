---
/*
 * Renderiza o rich text do Keystatic.
 *
 * O campo `fields.markdoc` grava Markdoc, e o leitor devolve a arvore ja
 * parseada (ver lerSubtitulo em src/config/aparencia.ts). Aqui ela vira HTML
 * pelo proprio Markdoc, com tres ajustes: cada paragrafo recebe a classe vinda
 * da pagina, o link ganha sublinhado e as marcas de cor viram <span> com as
 * classes declaradas em src/keystatic/marcas-de-cor.tsx.
 *
 * Sai como HTML estatico em vez de um componente React: nao vale uma ilha e
 * uma dependencia de runtime pra desenhar um paragrafo. O renderer de HTML do
 * Markdoc escapa o texto, entao o set:html nao abre brecha pra marcacao vinda
 * do painel.
 */
import Markdoc, { type Config, type Node, type Schema } from "@markdoc/markdoc";
import { marcasDeCor } from "@/keystatic/marcas-de-cor";

// O pacote resolve para CommonJS no Node, que nao expoe exports nomeados.
const { Tag } = Markdoc;

interface Props {
  /** A arvore do Markdoc, como o leitor do Keystatic devolve. */
  conteudo: Node;
  /** Classes aplicadas a cada paragrafo. */
  class?: string;
}

const { conteudo, class: classe = "" } = Astro.props;

// As classes estao escritas por extenso em marcas-de-cor.tsx, que e onde o
// Tailwind as enxerga. Aqui elas so sao lidas de la.
const tagsDeCor: Record<string, Schema> = Object.fromEntries(
  Object.entries(marcasDeCor).map(([nome, marca]): [string, Schema] => [
    nome,
    {
      inline: true,
      transform: (no, config) =>
        new Tag(
          marca.tag ?? "span",
          { class: marca.className },
          no.transformChildren(config),
        ),
    },
  ]),
);

const config: Config = {
  nodes: {
    // Por padrao o documento vira <article>; aqui so os paragrafos interessam.
    document: {
      transform: (no, config) => no.transformChildren(config),
    },
    paragraph: {
      transform: (no, config) =>
        new Tag("p", { class: classe }, no.transformChildren(config)),
    },
    link: {
      attributes: { href: { type: String } },
      transform: (no, config) =>
        new Tag(
          "a",
          { href: no.attributes.href, class: "underline underline-offset-2" },
          no.transformChildren(config),
        ),
    },
  },
  tags: tagsDeCor,
};

const html = Markdoc.renderers.html(Markdoc.transform(conteudo, config));
---

<Fragment set:html={html} />
