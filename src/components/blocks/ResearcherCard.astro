---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import {
  NIVEL_LABELS,
  IDENTIDADE_LABELS,
  RACA_LABELS,
  CATEGORY_BADGE,
} from "@/utils/labels";
import {
  buildResearcherView,
  type ResearcherResolvers,
} from "@/utils/researcher-view";

interface Props extends ResearcherResolvers {
  researcher: CollectionEntry<"researchers">;
}

const { researcher, ...resolvers } = Astro.props;
const vm = buildResearcherView(researcher, resolvers);
const { r } = vm;
---

<div
  class="relative flex flex-col justify-between overflow-hidden rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-lg"
  {...vm.dataAttrs}
>
  <div
    class="pointer-events-none absolute top-0 right-0 size-24 rounded-bl-full bg-gradient-to-bl from-primary/10 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="relative">
    <a
      href={`/pesquisadoras/${researcher.id}`}
      class="group/link mb-3 flex items-start gap-3"
    >
      <div class="avatar avatar-placeholder shrink-0">
        <div
          class="mask w-14 bg-gradient-to-br from-primary/20 to-secondary/20 mask-squircle text-primary"
        >
          <span class="text-lg font-semibold">{vm.initials}</span>
        </div>
      </div>
      <div class="min-w-0 flex-1">
        <h3
          class="truncate text-base leading-tight font-bold group-hover/link:text-primary"
        >
          <span class="text-primary">{vm.primeiroNome}</span>
          {vm.restoNome && <span> {vm.restoNome}</span>}
        </h3>
        {
          r.nivel_formacao && (
            <p class="mt-0.5 text-xs font-semibold text-primary">
              {NIVEL_LABELS[r.nivel_formacao]}
            </p>
          )
        }
        {
          vm.instituicaoFormatada && (
            <p class="truncate text-xs text-base-content/50">
              <Icon name="mdi:bank-outline" class="mr-1 inline size-3" />
              {vm.instituicaoFormatada}
            </p>
          )
        }
      </div>
    </a>

    <div class="mb-4 space-y-2.5">
      {
        vm.localizacaoFormatada && (
          <div class="flex items-center gap-1.5 text-xs text-base-content/60">
            <Icon name="mdi:map-marker-outline" class="size-3.5 text-primary" />
            <span>{vm.localizacaoFormatada}</span>
          </div>
        )
      }

      <div class="flex flex-wrap gap-1.5">
        {
          vm.showIdentidade && (
            <span
              class={`badge ${CATEGORY_BADGE.identidade.color} gap-1 badge-sm`}
            >
              <Icon name={CATEGORY_BADGE.identidade.icon} class="size-3" />
              {IDENTIDADE_LABELS[r.identidade_genero!]}
            </span>
          )
        }
        {
          vm.showRaca && (
            <span class={`badge ${CATEGORY_BADGE.raca.color} gap-1 badge-sm`}>
              <Icon name={CATEGORY_BADGE.raca.icon} class="size-3" />
              {RACA_LABELS[r.raca_etnia!]}
            </span>
          )
        }
        {
          vm.showLgbtqiap && (
            <span
              class={`badge ${CATEGORY_BADGE.lgbtqiap.color} gap-1 badge-sm`}
            >
              <Icon name={CATEGORY_BADGE.lgbtqiap.icon} class="size-3" />
              LGBTQIAP+
            </span>
          )
        }
        {
          vm.showPcd && (
            <span class={`badge ${CATEGORY_BADGE.pcd.color} gap-1 badge-sm`}>
              <Icon name={CATEGORY_BADGE.pcd.icon} class="size-3" />
              PCD
            </span>
          )
        }
        {
          vm.showGrupoTradicional && (
            <span
              class={`badge ${CATEGORY_BADGE.grupoTradicional.color} gap-1 badge-sm`}
            >
              <Icon
                name={CATEGORY_BADGE.grupoTradicional.icon}
                class="size-3"
              />
              {r.grupo_tradicional}
            </span>
          )
        }
        {
          vm.gruposBiologicosList.map((grupo) => (
            <span
              class={`badge ${CATEGORY_BADGE.grupoBiologico.color} gap-1 badge-sm`}
            >
              <Icon name={CATEGORY_BADGE.grupoBiologico.icon} class="size-3" />
              {grupo}
            </span>
          ))
        }
        {
          !vm.showIdentidade &&
            !vm.showRaca &&
            !vm.showLgbtqiap &&
            !vm.showPcd &&
            !vm.showGrupoTradicional &&
            vm.gruposBiologicosList.length === 0 && (
              <span class="text-xs text-base-content/40">—</span>
            )
        }
      </div>
    </div>
  </div>

  <div
    class="relative flex items-center justify-between border-t border-base-300 pt-3"
  >
    <div class="flex items-center gap-1">
      {
        vm.links.length > 0 ? (
          vm.links.map((link) => (
            <a
              href={link.href}
              target={link.href?.startsWith("http") ? "_blank" : undefined}
              rel="noopener noreferrer"
              title={link.title}
              class="btn btn-square btn-ghost text-base-content/50 btn-xs hover:bg-primary/10 hover:text-primary"
            >
              <Icon name={link.icon} class="size-4" />
            </a>
          ))
        ) : (
          <span class="text-xs text-base-content/30">—</span>
        )
      }
    </div>
    <a
      href={`/pesquisadoras/${researcher.id}`}
      class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:text-primary/80"
    >
      Ver perfil
      <Icon name="mdi:arrow-right" class="size-3" />
    </a>
  </div>
</div>
