---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { NIVEL_LABELS, CATEGORY_BADGE, PILL_BASE } from "@/utils/labels";
import {
  buildResearcherView,
  type ResearcherResolvers,
} from "@/utils/researcher-view";

interface Props extends ResearcherResolvers {
  researcher: CollectionEntry<"researchers">;
}

const { researcher, ...resolvers } = Astro.props;
const vm = buildResearcherView(researcher, resolvers);
const { r } = vm;

// O card tem mais largura que a celula da tabela, entao cabe mais etiqueta
// antes de precisar do +N. Na tabela o limite continua 3.
const VISIBLE_BADGES = 5;
const visibleBadges = vm.badges.slice(0, VISIBLE_BADGES);

// A citação é cortada por número de caracteres, e não só por linhas: o
// line-clamp esconde via CSS mas mantém o texto inteiro no HTML, o que faz a
// busca da página e leitores de tela lerem um trecho que ninguém vê. Corta na
// última palavra inteira pra não terminar no meio de uma sílaba; o texto
// completo fica no perfil.
const BIO_MAX = 150;

function encurtar(texto: string, max: number) {
  if (texto.length <= max) return texto;
  const corte = texto.slice(0, max);
  const espaco = corte.lastIndexOf(" ");
  const base = espaco > max * 0.6 ? corte.slice(0, espaco) : corte;
  return base.replace(/[\s.,;:!?-]+$/, "") + "…";
}

const bioResumida = r.bio ? encurtar(r.bio.trim(), BIO_MAX) : "";
const remainingCount = vm.badges.length - visibleBadges.length;
---

<div
  class="flex h-full flex-col justify-between rounded-lg border border-gray-100 bg-white p-5 transition-all hover:border-meco-purple-soft/60"
  {...vm.dataAttrs}
>
  <div>
    {/* Cabeçalho */}
    <a
      href={`/pesquisadoras/${researcher.id}`}
      class="group/link flex items-start gap-3"
    >
      <div
        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-meco-purple-primary/15 to-meco-green-primary/15 font-epilogue text-base font-bold text-meco-purple-primary"
      >
        {vm.initials}
      </div>
      <div class="min-w-0 flex-1">
        <h3
          class="line-clamp-1 font-epilogue text-lg font-bold text-gray-900 transition-colors group-hover/link:text-meco-purple-primary"
        >
          {vm.nomeFormatado}
        </h3>
        {
          r.nivel_formacao && (
            <span
              class={`${PILL_BASE} ${CATEGORY_BADGE.nivelFormacao.color} mt-1 text-sm`}
            >
              {NIVEL_LABELS[r.nivel_formacao]}
            </span>
          )
        }
        {
          vm.instituicaoFormatada && (
            <p class="line-clamp-1 text-sm text-gray-500">
              {vm.instituicaoFormatada}
            </p>
          )
        }
        {
          vm.localizacaoFormatada && (
            <p class="mt-1 flex items-center gap-1.5 text-sm text-gray-500">
              <Icon
                name="mdi:map-marker-outline"
                class="size-4 shrink-0 text-meco-purple-primary"
              />
              <span class="truncate">{vm.localizacaoFormatada}</span>
            </p>
          )
        }
      </div>
    </a>

    {/* Corpo — pergunta norteadora de pesquisa */}
    {
      vm.show("bio", r.bio) && (
        <p
          class="my-3 rounded-lg border-l-2 border-meco-purple-primary bg-gray-50/70 px-3 py-4 text-sm leading-relaxed text-gray-600 italic"
          title={r.bio}
        >
          {bioResumida}
        </p>
      )
    }

    {/* Badges com overflow */}
    <div class="mt-3 flex flex-wrap items-center gap-1.5">
      {
        visibleBadges.map((badge) => (
          <span
            class={`${PILL_BASE} ${CATEGORY_BADGE[badge.key].color} text-sm`}
            title={badge.full !== badge.label ? badge.full : undefined}
          >
            {badge.label}
          </span>
        ))
      }
      {
        remainingCount > 0 && (
          <span class="badge-numero inline-flex bg-[#bf9ee3] text-xs font-bold text-gray-950">
            +{remainingCount}
          </span>
        )
      }
      {vm.badges.length === 0 && <span class="text-sm text-gray-500">—</span>}
    </div>
  </div>

  {/* Rodapé */}
  <div
    class="mt-4 flex items-center justify-between border-t border-gray-100 pt-3"
  >
    <div class="flex items-center gap-2">
      {
        vm.links.slice(0, 3).map((link) => (
          <a
            href={link.href}
            target={link.href?.startsWith("http") ? "_blank" : undefined}
            rel="noopener noreferrer"
            title={link.title}
            aria-label={link.title}
            class="flex size-10 items-center justify-center rounded-lg bg-gray-100 text-gray-600 transition-all hover:bg-meco-purple-primary hover:text-white"
          >
            <Icon name={link.icon} class="size-5" />
          </a>
        ))
      }
    </div>

    <a
      href={`/pesquisadoras/${researcher.id}`}
      class="group/btn inline-flex items-center gap-1.5 text-sm font-bold text-meco-purple-primary hover:text-meco-purple-deep"
    >
      {pesquisadoras.botoes.verPerfil}
      <Icon
        name="mdi:arrow-right"
        class="size-4 transition-transform group-hover/btn:translate-x-0.5"
      />
    </a>
  </div>
</div>
