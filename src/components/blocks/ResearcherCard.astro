---
import type { CollectionEntry } from "astro:content";

interface Props {
  researcher: CollectionEntry<"researchers">;
}

const { researcher } = Astro.props;
const r = researcher.data;

const handleInstagramLink = (instagram?: string) => {
  if (!instagram) return "";
  return instagram.startsWith("http")
    ? instagram
    : `https://instagram.com/${instagram}`;
};
---

<div
  class="researcher-card group flex h-full flex-col rounded-lg border border-neutral-200 bg-white p-6 transition-shadow hover:shadow-lg dark:border-neutral-800 dark:bg-neutral-950"
  data-genero={r.genero || ""}
  data-localizacao={r.localizacao || ""}
  data-formacao={r.formacao || ""}
>
  {/* Image Section */}
  {
    r.imagem && (
      <div class="mb-4 h-48 w-full overflow-hidden rounded-md bg-neutral-100 dark:bg-neutral-800">
        <img
          src={r.imagem}
          alt={r.nome || "Pesquisadora"}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      </div>
    )
  }

  {/* Identity Section */}
  <div class="mb-4">
    <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">
      {r.nome || "Pesquisadora Sem Nome"}
    </h3>
    {
      r.formacao && (
        <p class="text-sm text-neutral-600 dark:text-neutral-400">
          {r.formacao}
        </p>
      )
    }
  </div>

  {/* Badges Section */}
  <div class="mb-4 flex flex-wrap gap-2 text-xs">
    {
      r.localizacao && (
        <span class="rounded-full bg-blue-100 px-3 py-1 font-medium text-blue-700 dark:bg-blue-900 dark:text-blue-200">
          📍 {r.localizacao}
        </span>
      )
    }
    {
      r.genero && (
        <span class="rounded-full bg-pink-100 px-3 py-1 font-medium text-pink-700 dark:bg-pink-900 dark:text-pink-200">
          {r.genero}
        </span>
      )
    }
  </div>

  {/* Contact Info */}
  <div class="mb-6 space-y-2">
    {
      r.email && (
        <a
          href={`mailto:${r.email}`}
          class="block truncate text-sm text-blue-600 hover:underline dark:text-blue-400"
        >
          ✉️ {r.email}
        </a>
      )
    }
    {
      r.telefone && (
        <a
          href={`tel:${r.telefone}`}
          class="block font-mono text-sm text-green-600 hover:underline dark:text-green-400"
        >
          📱 {r.telefone}
        </a>
      )
    }
  </div>

  {/* Professional Links - Pushed to bottom */}
  <div
    class="mt-auto flex flex-wrap gap-2 border-t border-neutral-100 pt-4 dark:border-neutral-800"
  >
    {
      r.curriculo && (
        <a
          href={r.curriculo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 rounded-md bg-neutral-200 px-3 py-1 text-xs font-bold text-neutral-700 transition-colors hover:bg-neutral-300 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700"
          title="Currículo Lattes"
        >
          📄 LATTES
        </a>
      )
    }
    {
      r.researchgate && (
        <a
          href={r.researchgate}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 rounded-md bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700 transition-colors hover:bg-blue-100 dark:bg-blue-900/30 dark:text-blue-200 dark:hover:bg-blue-900/50"
          title="ResearchGate"
        >
          🔬 RG
        </a>
      )
    }
    {
      r.instagram && (
        <a
          href={handleInstagramLink(r.instagram)}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 rounded-md bg-pink-50 px-3 py-1 text-xs font-bold text-pink-700 transition-colors hover:bg-pink-100 dark:bg-pink-900/30 dark:text-pink-200 dark:hover:bg-pink-900/50"
          title="Instagram"
        >
          📷 IG
        </a>
      )
    }
    {
      r.site_pessoal && (
        <a
          href={r.site_pessoal}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 rounded-md bg-purple-50 px-3 py-1 text-xs font-bold text-purple-700 transition-colors hover:bg-purple-100 dark:bg-purple-900/30 dark:text-purple-200 dark:hover:bg-purple-900/50"
          title="Site Pessoal"
        >
          🌐 SITE
        </a>
      )
    }
  </div>
</div>

<style>
  .researcher-card {
    /* Garante que o card ocupe o espaço necessário no grid */
    min-height: 100%;
  }
</style>
