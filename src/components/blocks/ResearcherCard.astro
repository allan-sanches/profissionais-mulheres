---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { NIVEL_LABELS, CATEGORY_BADGE, PILL_BASE } from "@/utils/labels";
import {
  buildResearcherView,
  type ResearcherResolvers,
} from "@/utils/researcher-view";

interface Props extends ResearcherResolvers {
  researcher: CollectionEntry<"researchers">;
}

const { researcher, ...resolvers } = Astro.props;
const vm = buildResearcherView(researcher, resolvers);
const { r } = vm;

const VISIBLE_BADGES = 3;
const visibleBadges = vm.badges.slice(0, VISIBLE_BADGES);
const remainingCount = vm.badges.length - visibleBadges.length;
---

<div
  class="flex h-full flex-col justify-between rounded-2xl border border-gray-100 bg-white p-5 shadow-sm transition-all hover:border-meco-purple-soft/60 hover:shadow-md"
  {...vm.dataAttrs}
>
  <div>
    {/* Cabeçalho */}
    <a
      href={`/pesquisadoras/${researcher.id}`}
      class="group/link flex items-start gap-3"
    >
      <div
        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-meco-purple-primary/15 to-meco-green-primary/15 font-epilogue text-sm font-bold text-meco-purple-primary"
      >
        {vm.initials}
      </div>
      <div class="min-w-0 flex-1">
        <h3
          class="line-clamp-1 font-epilogue text-base font-bold text-gray-900 transition-colors group-hover/link:text-meco-purple-primary"
        >
          {vm.nomeFormatado}
        </h3>
        {
          r.nivel_formacao && (
            <p class="text-xs font-semibold text-meco-purple-primary">
              {NIVEL_LABELS[r.nivel_formacao]}
            </p>
          )
        }
        {
          vm.instituicaoFormatada && (
            <p class="line-clamp-1 text-xs text-gray-500">
              {vm.instituicaoFormatada}
            </p>
          )
        }
        {
          vm.localizacaoFormatada && (
            <p class="mt-0.5 flex items-center gap-1 text-xs text-gray-400">
              <Icon
                name="mdi:map-marker-outline"
                class="size-3 shrink-0 text-meco-purple-primary"
              />
              <span class="truncate">{vm.localizacaoFormatada}</span>
            </p>
          )
        }
      </div>
    </a>

    {/* Corpo — pergunta norteadora de pesquisa */}
    {
      vm.show("bio", r.bio) && (
        <p class="my-3 line-clamp-2 rounded-xl border-l-2 border-meco-purple-primary bg-gray-50/70 p-2.5 text-xs text-gray-600 italic">
          {r.bio}
        </p>
      )
    }

    {/* Badges com overflow */}
    <div class="mt-3 flex flex-wrap items-center gap-1.5">
      {
        visibleBadges.map((badge) => (
          <span class={`${PILL_BASE} ${CATEGORY_BADGE[badge.key].color}`}>
            <Icon name={CATEGORY_BADGE[badge.key].icon} class="size-3" />
            {badge.label}
          </span>
        ))
      }
      {
        remainingCount > 0 && (
          <span class="rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-bold text-gray-600">
            +{remainingCount}
          </span>
        )
      }
      {vm.badges.length === 0 && <span class="text-xs text-gray-400">—</span>}
    </div>
  </div>

  {/* Rodapé */}
  <div
    class="mt-4 flex items-center justify-between border-t border-gray-100 pt-3"
  >
    <div class="flex items-center gap-1.5">
      {
        vm.links.slice(0, 3).map((link) => (
          <a
            href={link.href}
            target={link.href?.startsWith("http") ? "_blank" : undefined}
            rel="noopener noreferrer"
            title={link.title}
            aria-label={link.title}
            class="flex size-7 items-center justify-center rounded-lg bg-gray-100 text-gray-600 transition-all hover:bg-meco-purple-primary hover:text-white"
          >
            <Icon name={link.icon} class="size-3.5" />
          </a>
        ))
      }
    </div>

    <a
      href={`/pesquisadoras/${researcher.id}`}
      class="group/btn inline-flex items-center gap-1 text-xs font-bold text-meco-purple-primary hover:text-meco-purple-deep"
    >
      Ver perfil
      <Icon
        name="mdi:arrow-right"
        class="size-3 transition-transform group-hover/btn:translate-x-0.5"
      />
    </a>
  </div>
</div>
