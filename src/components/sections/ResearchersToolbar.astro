---
import { Icon } from "astro-icon/components";
import { pesquisadoras } from "@/config/aparencia";

interface Props {
  ultimaSincronizacaoLabel?: string;
}

const { ultimaSincronizacaoLabel } = Astro.props;

// Rotulos vindos do painel (secao "Pagina de pesquisadoras").
const { botoes, buscaPlaceholder } = pesquisadoras;
---

<div
  class="flex flex-col items-stretch justify-between gap-4 sm:flex-row sm:items-center"
>
  <div class="flex max-w-xl flex-1 items-center gap-3">
    <button
      id="toggle-filters-btn"
      type="button"
      class="relative flex h-12 shrink-0 items-center gap-2 rounded-lg border border-gray-300 bg-white px-5 text-base font-medium text-gray-700 transition-all hover:border-meco-purple-soft hover:bg-gray-50"
      title="Abrir filtros (Ctrl+B)"
      aria-pressed="false"
      aria-expanded="false"
      aria-controls="filter-drawer"
    >
      <Icon name="mdi:filter-variant" class="size-5 text-meco-purple-primary" />
      <span>{botoes.filtros}</span>
      <span
        id="filter-count-badge"
        class="badge-numero hidden bg-[#bf9ee3] text-xs font-bold text-gray-950"
        >0</span
      >
    </button>

    <div class="relative flex-1">
      <Icon
        name="mdi:magnify"
        class="absolute top-1/2 left-4 size-5 -translate-y-1/2 text-gray-500"
      />
      <label for="filter-search" class="sr-only">Buscar pesquisadoras</label>
      <input
        id="filter-search"
        type="search"
        class="h-12 w-full rounded-lg border border-gray-300 bg-white pr-4 pl-11 text-base transition-all focus:border-transparent focus:ring-2 focus:ring-meco-purple-primary focus:outline-none"
        placeholder={buscaPlaceholder}
        aria-label="Buscar pesquisadoras"
      />
    </div>
  </div>

  {
    /* flex-wrap no mobile: os quatro controles nao cabem numa linha de 360px e
    sem quebra o ultimo era empurrado pra fora da tela. */
  }
  <div
    class="flex shrink-0 flex-wrap items-center justify-between gap-x-4 gap-y-3 text-sm text-gray-500 sm:flex-nowrap sm:justify-end"
  >
    <div
      class="flex shrink-0 items-center gap-2 text-sm font-medium text-gray-500"
    >
      <span
        class="size-2 shrink-0 animate-pulse rounded-full bg-meco-green-primary"
      ></span>
      {
        ultimaSincronizacaoLabel ? (
          <span class="whitespace-nowrap">
            Atualizado em <time>{ultimaSincronizacaoLabel}</time>
          </span>
        ) : (
          "Atualizado"
        )
      }
    </div>

    <button
      id="help-btn"
      type="button"
      class="flex shrink-0 items-center gap-2 text-sm font-medium text-meco-purple-primary transition-colors hover:text-meco-purple-deep hover:underline"
    >
      <Icon name="mdi:help-circle-outline" class="size-5 shrink-0" />
      <span>{botoes.comoUtilizar}</span>
    </button>

    {
      /* A pilula inteira sai no mobile, e nao so o grupo de botoes: ela nao
      guarda mais nada alem do alternador, entao esconder so o conteudo
      deixaria uma caixa cinza vazia de 48px na tela.

      E some porque ali a listagem e sempre em cards — a tabela tem cinco
      colunas e nao cabe numa tela estreita —, entao o alternador so ofereceria
      uma opcao que nao existe. */
    }
    <div
      class="hidden h-12 shrink-0 items-center gap-1 rounded-lg border border-gray-200/80 bg-gray-100 p-1 sm:inline-flex"
    >
      <div
        class="inline-flex items-center gap-1"
        role="group"
        aria-label="Alternar visualização"
      >
        <button
          id="btn-view-table"
          type="button"
          class="flex h-full items-center gap-2 rounded-lg px-4 text-sm leading-none font-bold transition-all"
          aria-pressed="true"
        >
          <Icon
            name="mdi:view-list"
            class="size-5 shrink-0 text-meco-purple-primary"
          />
          Tabela
        </button>
        <button
          id="btn-view-cards"
          type="button"
          class="flex h-full items-center gap-2 rounded-lg px-4 text-sm leading-none font-bold transition-all"
          aria-pressed="false"
        >
          <Icon
            name="mdi:view-grid-outline"
            class="size-5 shrink-0 text-meco-purple-primary"
          />
          Cards
        </button>
      </div>
    </div>

    {
      /* Fora da pilula: ela agrupa o alternador de visao, e o seletor de itens
      por pagina nao tem relacao com ele — juntos, so obrigavam um divisor no
      meio. Solto aqui, usa a mesma marcacao do seletor da barra de paginacao
      (ver ResearchersPagination.astro), pra os dois lerem como o mesmo
      controle repetido no topo e no rodape da lista. */
    }
    <label
      class="flex h-12 shrink-0 items-center justify-center gap-2 text-sm font-medium whitespace-nowrap text-gray-600"
    >
      <span class="sr-only">Itens por página</span>
      <select
        data-page-size
        class="h-10 rounded-lg border border-gray-300 bg-white px-2 text-sm font-bold focus:ring-2 focus:ring-meco-purple-primary focus:outline-none"
      >
        <option value="5">5</option>
        <option value="10">10</option>
        <option value="20" selected>20</option>
        <option value="50">50</option>
        <option value="100">100</option>
      </select>
      por página
    </label>
  </div>
</div>
