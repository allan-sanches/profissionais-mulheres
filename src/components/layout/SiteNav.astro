---
import { identidade, navegacao } from "@/config/aparencia";

// O menu espelha o do site principal. O item que aponta pra cá é marcado como
// página atual — é o equivalente ao destaque verde que o Wix dá à seção aberta.
const aqui = new URL(Astro.site ?? "https://profissionais-mulheres.vercel.app/")
  .hostname;

const links = navegacao.links.map((link) => ({
  ...link,
  atual: new URL(link.endereco).hostname === aqui,
}));
---

<nav
  aria-label="Navegação do site"
  {/* A barra fica fora do container centralizado, entao ja ocupa a janela
    inteira: o padding aqui e o recuo do proprio conteudo dela. */}
  class="border-b border-gray-100 bg-white px-6 py-4 md:px-10"
>
  <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
    <a
      href={navegacao.enderecoDaLogo}
      class="shrink-0 transition-opacity hover:opacity-80"
      aria-label="Ir para o site principal"
    >
      {
        /* Altura vem do painel; a largura acompanha por `w-auto`, mantendo a
        proporcao de qualquer imagem que troquem ali. `max-w-full` impede que
        uma logo muito larga estoure a barra numa tela estreita.

        Sem `lazy`: a barra fica no topo, entao adiar a carga so atrasaria o que
        ja esta na tela. */
      }
      <img
        src={identidade.logoMenu}
        alt=""
        style={`height: ${identidade.alturaLogoMenu}px`}
        class="w-auto max-w-full"
        decoding="async"
      />
    </a>

    <ul class="flex flex-wrap items-center justify-center gap-x-7 gap-y-2">
      {
        links.map((link) => (
          <li>
            <a
              href={link.endereco}
              aria-current={link.atual ? "page" : undefined}
              class:list={[
                "text-base transition-colors hover:text-meco-green-primary",
                link.atual
                  ? "font-semibold text-meco-green-primary"
                  : "text-gray-700",
              ]}
            >
              {link.rotulo}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
