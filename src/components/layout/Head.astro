---
import site from "@/config/site";
import { identidade } from "@/config/aparencia";
import type { HeadProps } from "@/types";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

type Props = HeadProps;

const {
  title,
  description,
  image = identidade.imagemDeCompartilhamento,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// A aba sempre termina no nome do site (secao "Identidade visual" do painel);
// a home nao passa titulo e fica so com ele.
const tituloDaAba = title
  ? `${title} — ${identidade.nomeDoSite}`
  : identidade.nomeDoSite;
---

<!-- Global Metadata -->
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  {
    /* Favicon — trocavel pela secao "Identidade visual" do painel. E o unico
     icone declarado de proposito: qualquer outro <link rel="icon"> com
     `sizes` concorre com ele, e o navegador escolhe o de tamanho mais
     proximo em vez deste. */
  }
  <link rel="icon" href={identidade.favicon} />
  <link rel="apple-touch-icon" href={identidade.favicon} />

  <!-- PWA Manifest — gerado a partir do painel (src/pages/manifest.webmanifest.ts) -->
  <link rel="manifest" href="/manifest.webmanifest" />

  <!-- Theme Color -->
  <meta name="theme-color" content="#3F9C87" />
  <meta name="msapplication-TileColor" content="#3F9C87" />

  <meta name="generator" content={Astro.generator} />

  <!-- Primary Meta Tags -->
  <title>{tituloDaAba}</title>
  <meta name="title" content={tituloDaAba} />
  <meta name="description" content={description} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={tituloDaAba} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.url)} />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={Astro.url} />
  <meta property="twitter:title" content={tituloDaAba} />
  <meta property="twitter:description" content={description} />
  <meta name="twitter:creator" content={`@${site.meta.author}`} />
  <meta name="twitter:image" content={new URL(image, Astro.url)} />

  <!-- RSS Link -->
  <link
    rel="alternate"
    type="application/rss+xml"
    title={identidade.nomeDoSite}
    href={new URL("rss.xml", Astro.site)}
  />

  <!-- canonical url -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- pagefind -->
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script src="/pagefind/pagefind-ui.js" is:inline></script>

  <!-- font  -->
  <Font cssVariable="--font-display" preload />

  <!-- View Transtions -->
  <ClientRouter />
</head>
