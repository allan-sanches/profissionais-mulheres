---
import site from "@/config/site";
import { Icon } from "astro-icon/components";

const year = new Date().getFullYear();
const { footer } = site;

// Links do rodapé em duas colunas. O número de linhas sai da quantidade de
// links pra que a segunda coluna comece na metade da lista — e vá junto se
// algum link for adicionado depois.
const linkRows = Math.ceil(footer.links.length / 2);
---

{
  /* Fora do container centralizado: a faixa ocupa a janela inteira em
  qualquer pagina, independente da largura do conteudo dela. */
}
<footer>
  {/* Faixa escura: logo + copyright, links do site e redes sociais */}
  {
    /* Padding inferior menor que o superior: a ultima linha ja vem com o
    respiro do mt-12 e do filete, entao 56px embaixo viravam vazio. */
  }
  <div class="bg-gray-100 px-8 pt-14 pb-8 text-gray-900 md:px-16">
    {
      /* Sem largura máxima própria: herda a do container da página. Um max-w
      fixo aqui desalinharia, e mudaria a cada página que usasse um container
      diferente — a home vai a 1800px e o perfil a 1280px. */
    }
    {
      /* Cada bloco ocupa a largura do proprio conteudo e o justify-between
      reparte a folga restante igualmente entre os dois vaos. Dar a folga a
      uma coluna so (1fr) inflava aquele bloco e apertava os outros dois. */
    }
    <div
      class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between md:gap-12"
    >
      {/* Logo */}
      <div>
        {
          /* O proprio logo escreve o nome da organizacao, entao nao ha rotulo
          ao lado - o nome aparece de novo so no copyright, no fim. */
        }
        <a
          href={site.mainSite.href}
          class="inline-flex transition-opacity hover:opacity-80"
        >
          <img
            src="/logo abreviada colorida.png"
            alt={footer.copyright}
            width="100"
            height="100"
            class="h-12 w-auto"
          />
        </a>
      </div>

      {/* Links do site */}
      {
        /* Sem titulo visivel, o nav precisa de um rotulo proprio: e por ele
        que leitores de tela anunciam a regiao e a distinguem da lista de
        redes sociais ao lado. */
      }
      <nav aria-label="Links do site">
        {
          /* grid-flow-col preenche coluna a coluna: os primeiros links descem
          na esquerda e o restante na direita, mantendo a ordem do menu. Um
          grid comum preencheria em ziguezague. O justify-start impede que as
          colunas implicitas estiquem pra ocupar a largura disponivel. */
        }
        <ul
          class="grid grid-flow-col justify-start gap-x-16 gap-y-3"
          style={`grid-template-rows: repeat(${linkRows}, min-content)`}
        >
          {
            footer.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-base text-gray-700 transition-colors hover:text-meco-purple-primary hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Redes sociais */}
      <div>
        <h2
          id="footer-social-heading"
          class="mb-4 font-epilogue text-xl font-bold text-gray-700"
        >
          {footer.socialHeading}
        </h2>
        <ul
          aria-labelledby="footer-social-heading"
          class="flex flex-wrap gap-3"
        >
          {
            footer.social.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={item.name}
                  aria-label={item.name}
                  class="flex size-12 items-center justify-center rounded-full bg-white text-meco-green-dark transition-colors hover:bg-meco-green-dark hover:text-white"
                >
                  <Icon name={item.icon} class="size-6" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      /* Ultima linha, atravessando a largura toda: separada das colunas por
      um filete discreto pra ler como rodape do rodape. */
    }
    <div
      class="mt-12 border-t border-gray-200 pt-6 text-center text-sm text-gray-700"
    >
      <p>
        Copyright © {year}
        {footer.copyright} · CNPJ {footer.cnpj} · {footer.tagline}
      </p>
      <p class="mt-1 text-gray-600">Desenvolvido por {footer.developer}</p>
    </div>
  </div>
</footer>
