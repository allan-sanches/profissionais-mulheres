---
import { identidade, navegacao, rodape } from "@/config/aparencia";
import { Icon } from "astro-icon/components";

const year = new Date().getFullYear();
const { creditos } = rodape;
---

{
  /* Fora do container centralizado: a faixa ocupa a janela inteira em
  qualquer pagina, independente da largura do conteudo dela. */
}
<footer>
  {
    /* Padding inferior menor que o superior: a ultima linha ja vem com o
    respiro do mt-8/mt-12 e do filete, entao um valor igual embaixo viraria
    vazio. */
  }
  <div
    class="bg-[#9c00ff] px-5 pt-10 pb-6 text-white sm:px-8 sm:pt-14 sm:pb-8 md:px-16"
  >
    {
      /* Sem largura máxima própria: herda a do container da página. Um max-w
      fixo aqui desalinharia, e mudaria a cada página que usasse um container
      diferente — a home vai a 1800px e o perfil a 1280px. */
    }
    <div class="grid grid-cols-1 gap-8 sm:gap-12 md:grid-cols-3">
      {/* Logo */}
      <div class="flex flex-col items-center justify-center">
        <a
          href={navegacao.enderecoDaLogo}
          class="inline-flex max-w-full transition-opacity hover:opacity-80"
        >
          {
            /* h-8 no mobile: a logo do rodape e bem larga, e os h-12 do desktop
            transbordavam uma tela de 360px. `max-w-full` fica como trava — se
            trocarem por uma imagem de outra proporcao, ela encolhe em vez de
            estourar a faixa. */
          }
          <img
            src={identidade.logoRodape}
            alt={creditos.organizacao}
            class="h-8 w-auto max-w-full sm:h-12"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>

      {
        /* Sem titulo visivel, o nav precisa de um rotulo proprio: e por ele que
        leitores de tela anunciam a regiao e a distinguem da lista de redes
        sociais ao lado. */
      }
      <nav aria-label="Links do site">
        <ul class="grid grid-cols-2 gap-x-4 gap-y-3 sm:gap-x-6 sm:gap-y-4">
          {
            rodape.links.map((link) => (
              <li>
                <a
                  href={link.endereco}
                  class="text-sm text-white transition-colors hover:text-gray-200 hover:underline sm:text-lg"
                >
                  {link.rotulo}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Redes sociais */}
      <div class="flex flex-col items-center">
        {
          /* text-lg no mobile: em text-3xl o titulo quebrava em duas linhas e
          pesava mais que o proprio nome da organizacao logo acima. */
        }
        <h2
          id="footer-social-heading"
          class="mb-4 text-center font-epilogue text-lg font-bold text-white sm:mb-6 sm:text-2xl md:text-3xl"
        >
          {rodape.tituloDasRedes}
        </h2>
        <ul
          aria-labelledby="footer-social-heading"
          class="flex flex-wrap justify-center gap-1 sm:gap-4"
        >
          {
            rodape.redes.map((rede) => (
              <li>
                <a
                  href={rede.endereco}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={rede.nome}
                  aria-label={rede.nome}
                  class="flex size-11 items-center justify-center text-white transition-colors hover:text-gray-200 sm:size-16"
                >
                  {/* size-11 mantem o alvo de toque em 44px, o minimo
                  recomendado, mesmo com o icone menor dentro. */}
                  <Icon name={rede.icone} class="size-6 sm:size-8" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      /* Ultima linha, atravessando a largura toda: separada das colunas por
      um filete discreto pra ler como rodape do rodape. */
    }
    <div
      class="mt-8 border-t border-white/20 pt-5 text-center text-xs text-white sm:mt-12 sm:pt-6 sm:text-sm"
    >
      <p>
        Copyright © {year}
        {creditos.organizacao} · CNPJ {creditos.cnpj} · {creditos.frase}
      </p>
      <p class="mt-1 text-white">
        Desenvolvido por {creditos.desenvolvidoPor}
      </p>
    </div>
  </div>
</footer>
