---
import site from "@/config/site";
import { Icon } from "astro-icon/components";

const year = new Date().getFullYear();
const { footer } = site;

// Links do rodapé em duas colunas. O número de linhas sai da quantidade de
// links pra que a segunda coluna comece na metade da lista — e vá junto se
// algum link for adicionado depois.
const linkRows = Math.ceil(footer.links.length / 2);
---

{
  /* Fora do container centralizado: a faixa ocupa a janela inteira em
  qualquer pagina, independente da largura do conteudo dela. */
}
<footer>
  {/* Faixa escura: logo + copyright, links do site e redes sociais */}
  {
    /* Padding inferior menor que o superior: a ultima linha ja vem com o
    respiro do mt-12 e do filete, entao 56px embaixo viravam vazio. */
  }
  <div class="bg-[#9c00ff] px-8 pt-14 pb-8 text-white md:px-16">
    {
      /* Sem largura máxima própria: herda a do container da página. Um max-w
      fixo aqui desalinharia, e mudaria a cada página que usasse um container
      diferente — a home vai a 1800px e o perfil a 1280px. */
    }
    {
      /* Cada bloco ocupa a largura do proprio conteudo e o justify-between
      reparte a folga restante igualmente entre os dois vaos. Dar a folga a
      uma coluna so (1fr) inflava aquele bloco e apertava os outros dois. */
    }
    <div class="grid grid-cols-1 gap-12 md:grid-cols-3">
      {/* Logo */}
      <div class="flex flex-col items-center justify-center">
        <a
          href={site.mainSite.href}
          class="inline-flex transition-opacity hover:opacity-80"
        >
          <img
            src="/logo 2 branca.png"
            alt={footer.copyright}
            width="100"
            height="100"
            class="h-12 w-auto"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>

      {/* Links do site */}
      <nav aria-label="Links do site">
        <ul class="grid grid-cols-2 gap-x-6 gap-y-4">
          {
            footer.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-lg text-white transition-colors hover:text-gray-200 hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Redes sociais */}
      <div class="flex flex-col items-center">
        <h2
          id="footer-social-heading"
          class="mb-6 text-center font-epilogue text-3xl font-bold text-white"
        >
          {footer.socialHeading}
        </h2>
        <ul
          aria-labelledby="footer-social-heading"
          class="flex flex-wrap justify-center gap-4"
        >
          {
            footer.social.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={item.name}
                  aria-label={item.name}
                  class="flex size-16 items-center justify-center text-white transition-colors hover:text-gray-200"
                >
                  <Icon name={item.icon} class="size-8" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      /* Ultima linha, atravessando a largura toda: separada das colunas por
      um filete discreto pra ler como rodape do rodape. */
    }
    <div
      class="mt-12 border-t border-white/20 pt-6 text-center text-sm text-white"
    >
      <p>
        Copyright © {year}
        {footer.copyright} · CNPJ {footer.cnpj} · {footer.tagline}
      </p>
      <p class="mt-1 text-white">Desenvolvido por {footer.developer}</p>
    </div>
  </div>
</footer>
