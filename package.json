    "@astrojs/vercel": "^10.0.4",
    "@googleapis/sheets": "^13.0.1",
    "@iconify-json/academicons": "^1.2.4",
    "@keystatic/astro": "^5.2.0",
    "@keystatic/core": "^0.6.0",
    "@tailwindcss/vite": "^4.1.18",
    "artalk": "^2.9.1",
    "astro": "^6.1.1",
    "astro-expressive-code": "^0.41.5",
    "astro-icon": "^1.1.5",
