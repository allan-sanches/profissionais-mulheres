# Umami Analytics (opcional)
# UMAMI_URL=https://your-umami-instance.com/script.js
# UMAMI_WEBSITE_ID=your-website-id

# ─────────────────────────────────────────────────────────────────────────────
# Keystatic — painel de edição publicado (/keystatic)
# ─────────────────────────────────────────────────────────────────────────────
# Só são necessárias no ambiente PUBLICADO. Rodando `npm run dev`, o painel usa
# armazenamento local e dispensa login (ver keystatic.config.ts).
#
# Precisam estar nas variáveis de ambiente da Vercel ANTES do build: o Keystatic
# as lê por `import.meta.env`, que é substituído no momento em que o site é
# construído — defini-las só em runtime não tem efeito.
#
# De onde vêm: crie um GitHub App em
#   https://github.com/settings/apps/new
# com estas configurações:
#   - Homepage URL:              https://<dominio-do-site>
#   - Callback URL:              https://<dominio-do-site>/api/keystatic/github/oauth/callback
#   - Request user authorization (OAuth) during installation: marcado
#   - Webhook:                   desmarcar "Active"
#   - Repository permissions:    Contents = Read and write
#                                Metadata = Read-only
#                                Pull requests = Read and write
# Depois de criar, instale o App no repositório profissionais-mulheres.

# "App ID" não; use o Client ID que aparece na página do App
KEYSTATIC_GITHUB_CLIENT_ID=
# Gerado em "Generate a new client secret" — aparece uma única vez
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Qualquer string aleatória e longa; assina o cookie de sessão do painel.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEYSTATIC_SECRET=
# O "slug" do App: o final da URL pública dele (github.com/apps/<slug>)
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
